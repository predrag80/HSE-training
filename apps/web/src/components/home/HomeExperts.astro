---
import './home-experts.css';
import type { Locale } from '../../i18n/config';
import { getUiTranslations } from '../../i18n/ui';

interface Props {
	readonly locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiTranslations(locale).homepage.experts;

const experts = [
	{ name: 'Bryan Jonhson', image: '/images/consulting-team-01.webp' },
	{ name: 'Jeremy Dupont', image: '/images/consulting-team-02.webp' },
	{ name: 'Matthew Taylor', image: '/images/consulting-team-03.webp' },
	{ name: 'Johncy Parker', image: '/images/consulting-team-04.webp' },
];
---

<section class="home-experts" aria-labelledby="home-experts-title" data-home-experts>
	<div class="home-experts__inner">
		<header class="home-experts__header" data-experts-reveal="header">
			<p>{copy.eyebrow}</p>
			<h2 id="home-experts-title">{copy.title}</h2>
		</header>

		<ul class="home-experts__grid" data-experts-reveal="grid">
			{
				experts.map((expert, index) => (
					<li>
						<figure class="expert-card">
							<div class="expert-card__image">
								<img src={expert.image} alt={expert.name} width="600" height="756" loading="lazy" decoding="async" />
								<div class="expert-card__overlay">
									<div class="expert-card__socials">
										<a href="https://www.facebook.com/" target="_blank" rel="noreferrer" aria-label={`${expert.name} on Facebook`}>
											<svg aria-hidden="true" viewBox="0 0 512 512"><path d="M176 299.3V512h116V299.3h86.5l18-97.8H292v-34.6c0-51.7 20.3-71.5 72.7-71.5 16.3 0 29.4.4 37 1.2V7.9C387.4 4 352.4 0 332.2 0 225.3 0 176 50.5 176 159.4v42.1h-66v97.8h66Z" /></svg>
										</a>
										<a href="https://dribbble.com/" target="_blank" rel="noreferrer" aria-label={`${expert.name} on Dribbble`}>
											<svg aria-hidden="true" viewBox="0 0 512 512"><path d="M256 8C119.3 8 8 119.3 8 256s111.3 248 248 248 248-111.3 248-248S392.7 8 256 8Zm164 114.4c29.5 36 47.4 82 47.8 132-7-1.5-77-15.7-147.5-6.8-5.8-14-11.2-26.4-18.6-41.6 78.3-32 113.8-77.5 118.3-83.6ZM396.4 97.9c-3.8 5.4-35.7 48.3-111 76.5-34.7-63.8-73.2-116.2-79-124 67.2-16.2 138 1.3 190 47.5Zm-230.5-33.3c5.6 7.7 43.4 60.1 78.5 122.5-99.1 26.3-186.4 25.9-195.8 25.8C62.4 147.2 106.7 92.6 166 64.6ZM44.2 256.3v-6.5c9.3.2 111.9 1.5 217.7-30.1 6.1 11.9 11.9 23.9 17.2 35.9-76.6 21.6-146.2 83.5-180.5 142.3-33.8-37.5-54.4-87.2-54.4-141.6ZM126 423.4c22.1-45.2 82.2-103.6 167.6-132.8 29.7 77.3 42 142.1 45.2 160.6-68.1 29-150 21.1-212.8-27.8Zm248.4 8.5c-2.2-12.9-13.4-74.9-41.2-151 66.4-10.6 124.7 6.8 131.9 9.1-9.4 58.9-43.3 109.8-90.7 141.9Z" /></svg>
										</a>
										<a href="https://x.com/" target="_blank" rel="noreferrer" aria-label={`${expert.name} on X`}>
											<svg aria-hidden="true" viewBox="0 0 512 512"><path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8l164.9-188.5L26.8 48h145.6l100.5 132.9L389.2 48Zm-24.8 373.8h39.1L151.1 88h-42l255.3 333.8Z" /></svg>
										</a>
									</div>
								</div>
							</div>
							<figcaption>
								<strong>{expert.name}</strong>
								<span>{copy.roles[index]}</span>
							</figcaption>
						</figure>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-home-experts]').forEach((section) => {
		if (section.dataset.expertsReady === 'true') return;
		section.dataset.expertsReady = 'true';
		const targets = section.querySelectorAll<HTMLElement>('[data-experts-reveal]');
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
			targets.forEach((target) => target.setAttribute('data-revealed', 'true'));
			return;
		}
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.setAttribute('data-revealed', 'true');
				observer.unobserve(entry.target);
			});
		}, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
		targets.forEach((target) => observer.observe(target));
	});
</script>
