---
import './home-experts.css';
import type { Locale } from '../../i18n/config';
import { getUiTranslations } from '../../i18n/ui';
import type { CompanyTeamMember } from '../../types/company';

interface Props {
	readonly locale: Locale;
	readonly experts: readonly CompanyTeamMember[];
	readonly headingId?: string;
}

const { locale, experts, headingId = 'home-experts-title' } = Astro.props;
const copy = getUiTranslations(locale).homepage.experts;

const fallbackImages: Readonly<Record<string, string>> = {
	'ana-springfield': '/images/team-ana-springfield.jpg',
	'john-springfield': '/images/team-john-springfield.jpg',
	'kristina-atanaskovic': '/images/team-kristina-atanaskovic.jpg',
	'marija-blagojevic': '/images/team-marija-blagojevic.webp',
};
---

<section class="home-experts" aria-labelledby={headingId} data-home-experts>
	<div class="home-experts__inner">
		<header class="home-experts__header" data-experts-reveal="header">
			<p>{copy.eyebrow}</p>
			<h2 id={headingId}>{copy.title}</h2>
		</header>

		<ul class="home-experts__grid" data-experts-reveal="grid">
			{
				experts.map((expert) => (
					<li>
						<figure class="expert-card">
							<div class="expert-card__image">
								{expert.image || fallbackImages[expert.memberKey] ? (
									<img
										src={expert.image?.url ?? fallbackImages[expert.memberKey]}
										alt={expert.image?.alt || expert.name}
										width={expert.image?.width ?? 600}
										height={expert.image?.height ?? 756}
										loading="lazy"
										decoding="async"
									/>
								) : (
									<div class="expert-card__placeholder" role="img" aria-label={`${expert.name} – photo coming soon`}><span>{expert.name.split(' ').map((part) => part[0]).join('')}</span></div>
								)}
							</div>
							<figcaption>
								<strong>{expert.name}</strong>
								<span>{expert.role}</span>
							</figcaption>
						</figure>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-home-experts]').forEach((section) => {
		if (section.dataset.expertsReady === 'true') return;
		section.dataset.expertsReady = 'true';
		const targets = section.querySelectorAll<HTMLElement>('[data-experts-reveal]');
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
			targets.forEach((target) => target.setAttribute('data-revealed', 'true'));
			return;
		}
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.setAttribute('data-revealed', 'true');
				observer.unobserve(entry.target);
			});
		}, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
		targets.forEach((target) => observer.observe(target));
	});
</script>
