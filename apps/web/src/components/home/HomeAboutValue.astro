---
import ValueIcon from './ValueIcon.astro';
import './home-about-value.css';
import type { CompanyProfile } from '../../types/company';
import type { Locale } from '../../i18n/config';
import { getLocalizedCmsHref } from '../../i18n/routes';
import { getUiTranslations } from '../../i18n/ui';

interface Props {
	content: CompanyProfile;
	locale: Locale;
}

const { content, locale } = Astro.props;
const copy = getUiTranslations(locale).homepage.about;
---

<section class="about-value" id="about" aria-labelledby="about-value-title" data-about-value>
	<h2 class="about-value__heading" id="about-value-title">{content.headline}</h2>

	<div class="about-value__inner">
		<ul class="about-value__highlights" data-about-reveal>
			{
				content.values.map((item) => (
					<li class="about-value__highlight">
						<ValueIcon name={item.iconKey} />
						<div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
						</div>
					</li>
				))
			}
		</ul>

		<div class="about-value__story">
			<div class="about-value__media" data-about-media>
				<div class="about-value__image about-value__image--primary">
					<img
						src={content.primaryImage.url}
						alt={copy.imageAlt}
						width={content.primaryImage.width}
						height={content.primaryImage.height}
						loading="lazy"
						decoding="async"
					/>
				</div>
				<div
					class="about-value__image about-value__image--secondary"
					aria-hidden="true"
					data-about-parallax
				>
					<img
						src={content.secondaryImage.url}
						alt=""
						width={content.secondaryImage.width}
						height={content.secondaryImage.height}
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>

			<div class="about-value__copy" data-about-reveal>
				<p class="about-value__eyebrow">{content.eyebrow}</p>
				<h3 class="about-value__title">{content.headline}</h3>
				<p class="about-value__description">{content.description}</p>

				<div class="about-value__actions">
					<a class="about-value__button" href={getLocalizedCmsHref(content.primaryCta.url, locale)}>{content.primaryCta.label}</a>
					<a class="about-value__text-link" href={getLocalizedCmsHref(content.secondaryCta.url, locale)}>{content.secondaryCta.label}</a>
				</div>

				<div
					class="about-value__signature"
					aria-label={`HSE Training — ${content.signatureLabel}`}
				>
					<strong aria-hidden="true">HSE</strong>
					<div aria-hidden="true">
						<span class="about-value__marks">◆ ◆ ◆</span>
						<span>{content.signatureLabel}</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	import { getAboutParallaxOffset } from './home-about-value-motion';

	document.querySelectorAll<HTMLElement>('[data-about-value]').forEach((section) => {
		if (section.dataset.aboutValueReady === 'true') return;
		section.dataset.aboutValueReady = 'true';
		section.dataset.revealReady = 'true';

		const media = section.querySelector<HTMLElement>('[data-about-media]');
		const parallaxImage = section.querySelector<HTMLElement>('[data-about-parallax]');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let parallaxFrame = 0;

		const updateParallax = () => {
			parallaxFrame = 0;
			if (!media || !parallaxImage) return;

			const mediaRect = media.getBoundingClientRect();
			const imageTop = mediaRect.top + parallaxImage.offsetTop;
			const offset = getAboutParallaxOffset(
				imageTop,
				parallaxImage.offsetHeight,
				window.innerHeight,
			);
			parallaxImage.style.setProperty('--about-parallax-y', `${offset}px`);
		};

		const requestParallaxUpdate = () => {
			if (parallaxFrame) return;
			parallaxFrame = window.requestAnimationFrame(updateParallax);
		};

		if (reducedMotion) {
			parallaxImage?.style.setProperty('--about-parallax-y', '0px');
			section.querySelectorAll('[data-about-reveal], [data-about-media]').forEach((element) => {
				element.setAttribute('data-revealed', 'true');
			});
			return;
		}

		updateParallax();
		window.addEventListener('scroll', requestParallaxUpdate, { passive: true });
		window.addEventListener('resize', requestParallaxUpdate);

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.setAttribute('data-revealed', 'true');
					observer.unobserve(entry.target);
				});
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
		);

		section.querySelectorAll('[data-about-reveal], [data-about-media]').forEach((element) => {
			observer.observe(element);
		});
	});
</script>
