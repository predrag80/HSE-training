---
import type { Course } from '../../types/course';
import { getCoursePublicPath } from '../../lib/course-routes';
import './home-pricing.css';

interface Props {
	readonly courses: readonly Course[];
}

const { courses } = Astro.props;
---

<section class="home-pricing" aria-labelledby="home-pricing-title" data-home-pricing>
	<div class="home-pricing__inner">
		<div class="home-pricing__intro">
			<div class="home-pricing__copy" data-pricing-reveal="left">
				<h2 id="home-pricing-title">Professional courses built around safer work.</h2>
				<p>Explore recognised health and safety qualifications with practical guidance from experienced HSE professionals.</p>
				<a class="home-pricing__all" href="/courses/">All courses</a>
			</div>

			<div class="pricing-accordion" data-pricing-reveal="right">
				{courses.map((course, index) => (
					<details open={index === 0}>
						<summary>
							<span>{course.title}</span>
							<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
						</summary>
						<div class="pricing-accordion__panel"><p>{course.shortDescription}</p></div>
					</details>
				))}
			</div>
		</div>

		<div class="pricing-plans" id="pricing-plans" data-pricing-reveal="plans">
			{
				courses.map((course) => (
					<article class="pricing-plan">
						<h3>{course.title}</h3>
						<p class="pricing-plan__users">{course.homepageLabel}</p>
						<div class="pricing-plan__price-row">
							<p class="pricing-plan__price pricing-plan__price--text">{course.visiblePrice}</p>
							<p class="pricing-plan__period">Current course fee and availability</p>
						</div>
						<ul>
							<li>
								<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6" /></svg>
								<span>{course.shortDescription}</span>
							</li>
						</ul>
						<a class="pricing-plan__button" href={getCoursePublicPath(course)}>{course.homepageCtaLabel}</a>
					</article>
				))
			}
		</div>

		<ul class="pricing-promises" data-pricing-reveal="promises">
			<li>
				<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 2v3M17 2v3M3 9h18M5 4h14a2 2 0 0 1 2 2v14H3V6a2 2 0 0 1 2-2Z" /><path d="m8 14 2.5 2.5L16 11" /></svg>
				<span>Recognised qualifications</span>
			</li>
			<li>
				<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 7h18v13H3zM3 10h18M16 15h2" /><path d="M5 7V5h14v2" /></svg>
				<span>Practical HSE knowledge</span>
			</li>
			<li>
				<svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
				<span>Flexible delivery options</span>
			</li>
		</ul>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-home-pricing]').forEach((section) => {
		if (section.dataset.pricingReady === 'true') return;
		section.dataset.pricingReady = 'true';

		const details = [...section.querySelectorAll<HTMLDetailsElement>('details')];
		if (window.matchMedia('(max-width: 74.999rem)').matches && details[0]) details[0].open = false;
		details.forEach((item) => {
			item.addEventListener('toggle', () => {
				if (!item.open) return;
				details.forEach((other) => {
					if (other !== item) other.open = false;
				});
			});
		});

		const targets = section.querySelectorAll<HTMLElement>('[data-pricing-reveal]');
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
			targets.forEach((target) => target.setAttribute('data-revealed', 'true'));
			return;
		}

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.setAttribute('data-revealed', 'true');
				observer.unobserve(entry.target);
			});
		}, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
		targets.forEach((target) => observer.observe(target));
	});
</script>
