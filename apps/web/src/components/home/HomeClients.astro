---
import './home-clients.css';

const clientLogos = [
	{ src: '/images/consulting-logo-envato.svg', alt: 'Envato' },
	{ src: '/images/consulting-logo-less.svg', alt: 'Less' },
	{ src: '/images/consulting-logo-pingdom.svg', alt: 'Pingdom' },
	{ src: '/images/consulting-logo-google.svg', alt: 'Google' },
];
---

<section class="home-clients" aria-labelledby="home-clients-title" data-home-clients>
	<div class="home-clients__background" aria-hidden="true"></div>
	<div class="home-clients__shade" aria-hidden="true"></div>
	<div class="home-clients__content">
		<div class="home-clients__stage">
			<button class="home-clients__play" type="button" aria-label="Play consulting video" data-client-video-open>
				<span class="home-clients__play-ring" aria-hidden="true"></span>
				<svg aria-hidden="true" viewBox="0 0 384 512"><path d="M73 39C58.2 29.9 39.6 29.6 24.5 38.1S0 62.6 0 80v352c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9l288-176c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39Z" /></svg>
			</button>
			<p class="home-clients__eyebrow">Supporting your business goal</p>
			<h2 id="home-clients-title">Some of the worldwide clients we've helped.</h2>
		</div>

		<ul class="home-clients__logos" aria-label="Clients">
			{clientLogos.map((logo) => (
				<li><a href="#" aria-label={logo.alt}><img src={logo.src} alt={logo.alt} loading="lazy" /></a></li>
			))}
		</ul>
	</div>

	<dialog class="home-clients__dialog" data-client-video-dialog aria-label="Consulting video">
		<button type="button" class="home-clients__dialog-close" aria-label="Close video" data-client-video-close>×</button>
		<div class="home-clients__video-frame" data-client-video-frame></div>
	</dialog>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-home-clients]').forEach((section) => {
		if (section.dataset.clientsReady === 'true') return;
		section.dataset.clientsReady = 'true';

		const background = section.querySelector<HTMLElement>('.home-clients__background');
		let frame = 0;
		const update = () => {
			frame = 0;
			const rect = section.getBoundingClientRect();
			const viewport = window.innerHeight;
			const progress = Math.max(0, Math.min(1, (viewport * 0.75 - rect.top) / (viewport * 0.75)));
			const eased = 1 - Math.pow(1 - progress, 2);
			section.style.setProperty('--clients-width', `${63 + 37 * eased}%`);
			if (background) {
				const offset = Math.max(-70, Math.min(70, (viewport / 2 - (rect.top + rect.height / 2)) * 0.12));
				background.style.setProperty('--clients-parallax-y', `${offset}px`);
			}
		};
		const requestUpdate = () => {
			if (frame) return;
			frame = window.requestAnimationFrame(update);
		};
		update();
		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('resize', requestUpdate, { passive: true });

		const dialog = section.querySelector<HTMLDialogElement>('[data-client-video-dialog]');
		const videoFrame = section.querySelector<HTMLElement>('[data-client-video-frame]');
		section.querySelector('[data-client-video-open]')?.addEventListener('click', () => {
			if (!dialog || !videoFrame) return;
			videoFrame.innerHTML = '<iframe src="https://www.youtube.com/embed/D5Ze-lXAJCc?autoplay=1" title="Consulting video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
			dialog.showModal();
		});
		const closeDialog = () => {
			if (!dialog || !videoFrame) return;
			dialog.close();
			videoFrame.replaceChildren();
		};
		section.querySelector('[data-client-video-close]')?.addEventListener('click', closeDialog);
		dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });
	});
</script>
