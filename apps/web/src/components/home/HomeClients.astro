---
import './home-clients.css';
import type { Locale } from '../../i18n/config';
import { getUiTranslations } from '../../i18n/ui';
import { clients } from '../../data/clients';
import ClientMarquee from '../shared/ClientMarquee.astro';

interface Props {
	readonly locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiTranslations(locale).homepage.clients;

---

<section class="home-clients" aria-labelledby="home-clients-title" data-home-clients>
	<div class="home-clients__background" aria-hidden="true"></div>
	<div class="home-clients__shade" aria-hidden="true"></div>
	<div class="home-clients__content">
		<div class="home-clients__stage">
			<p class="home-clients__eyebrow">{copy.eyebrow}</p>
			<h2 id="home-clients-title">{copy.title}</h2>
		</div>

		<ClientMarquee {clients} label={copy.logosLabel} variant="dark" />
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-home-clients]').forEach((section) => {
		if (section.dataset.clientsReady === 'true') return;
		section.dataset.clientsReady = 'true';

		const background = section.querySelector<HTMLElement>('.home-clients__background');
		let frame = 0;
		const update = () => {
			frame = 0;
			const rect = section.getBoundingClientRect();
			const viewport = window.innerHeight;
			const progress = Math.max(0, Math.min(1, (viewport * 0.75 - rect.top) / (viewport * 0.75)));
			const eased = 1 - Math.pow(1 - progress, 2);
			section.style.setProperty('--clients-width', `${63 + 37 * eased}%`);
			if (background) {
				const offset = Math.max(-70, Math.min(70, (viewport / 2 - (rect.top + rect.height / 2)) * 0.12));
				background.style.setProperty('--clients-parallax-y', `${offset}px`);
			}
		};
		const requestUpdate = () => {
			if (frame) return;
			frame = window.requestAnimationFrame(update);
		};
		update();
		window.addEventListener('scroll', requestUpdate, { passive: true });
		window.addEventListener('resize', requestUpdate, { passive: true });

	});
</script>
