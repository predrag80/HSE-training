---
import type { Locale } from '../../i18n/config';
import { getSearchIndexPath } from '../../lib/search/search-match';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'sr'
	? {
		open: 'Otvori pretragu sajta',
		close: 'Zatvori pretragu sajta',
		question: 'Šta tražite?',
		placeholder: 'Unesite ključne reči...',
		submit: 'Pokreni pretragu',
		results: {
			kinds: { page: 'Stranica', course: 'Kurs', training: 'Obuka', service: 'Usluga', resource: 'Resurs' },
			loading: 'Učitavanje pretrage...',
			unavailable: 'Pretraga trenutno nije dostupna. Pokušajte ponovo kasnije.',
			noResults: 'Nema rezultata za „{query}”.',
			countOne: '{count} rezultat',
			countOther: '{count} rezultata',
			newTab: '(otvara se u novom tabu)',
		},
	}
	: {
		open: 'Open site search',
		close: 'Close site search',
		question: 'What are you looking for?',
		placeholder: 'Enter your keywords...',
		submit: 'Submit search',
		results: {
			kinds: { page: 'Page', course: 'Course', training: 'Training', service: 'Service', resource: 'Resource' },
			loading: 'Loading search...',
			unavailable: 'Search is temporarily unavailable. Please try again later.',
			noResults: 'No results for “{query}”.',
			countOne: '{count} result',
			countOther: '{count} results',
			newTab: '(opens in a new tab)',
		},
	};
const searchIndexUrl = getSearchIndexPath(locale);
---

<button
	class="site-search-button"
	type="button"
	aria-controls="site-search-dialog"
	aria-expanded="false"
	aria-label={copy.open}
	data-search-button
>
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<path d="M11 2C15.9706 2 20 6.02944 20 11C20 13.125 19.2619 15.0766 18.0303 16.6162L21.707 20.293L21.7764 20.3691C22.0963 20.7619 22.0729 21.3411 21.707 21.707C21.3411 22.073 20.7619 22.0963 20.3691 21.7764L20.293 21.707L16.6162 18.0303C15.0766 19.2619 13.125 20 11 20C6.02944 20 2 15.9706 2 11C2 6.02944 6.02944 2 11 2ZM11 4C7.13401 4 4 7.13401 4 11C4 14.866 7.13401 18 11 18C12.8905 18 14.6047 17.2492 15.8643 16.0312C15.8884 16.0007 15.9151 15.9716 15.9434 15.9434C15.9716 15.9151 16.0006 15.8884 16.0312 15.8643C17.2492 14.6047 18 12.8905 18 11C18 7.13401 14.866 4 11 4Z"></path>
	</svg>
</button>

<dialog
	class="site-search-dialog"
	id="site-search-dialog"
	aria-labelledby="site-search-title"
	data-search-dialog
	data-search-index={searchIndexUrl}
	data-search-copy={JSON.stringify(copy.results)}
>
	<div class="site-search-dialog__inner">
		<button class="site-search-dialog__close" type="button" aria-label={copy.close} data-search-close>
			<span aria-hidden="true">×</span>
		</button>

		<form class="site-search-form" role="search" data-search-form>
			<label class="site-search-form__label" id="site-search-title" for="site-search-query">
				{copy.question}
			</label>
			<div class="site-search-form__field">
				<input
					id="site-search-query"
					name="q"
					type="search"
					placeholder={copy.placeholder}
					autocomplete="off"
					aria-describedby="site-search-status"
					required
					data-search-input
				/>
				<button type="submit" aria-label={copy.submit}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M11 2C15.9706 2 20 6.02944 20 11C20 13.125 19.2619 15.0766 18.0303 16.6162L21.707 20.293L21.7764 20.3691C22.0963 20.7619 22.0729 21.3411 21.707 21.707C21.3411 22.073 20.7619 22.0963 20.3691 21.7764L20.293 21.707L16.6162 18.0303C15.0766 19.2619 13.125 20 11 20C6.02944 20 2 15.9706 2 11C2 6.02944 6.02944 2 11 2ZM11 4C7.13401 4 4 7.13401 4 11C4 14.866 7.13401 18 11 18C12.8905 18 14.6047 17.2492 15.8643 16.0312C15.8884 16.0007 15.9151 15.9716 15.9434 15.9434C15.9716 15.9151 16.0006 15.8884 16.0312 15.8643C17.2492 14.6047 18 12.8905 18 11C18 7.13401 14.866 4 11 4Z"></path>
					</svg>
				</button>
			</div>
			<p class="site-search-status" id="site-search-status" role="status" data-search-status></p>
			<ul class="site-search-results" data-search-results hidden></ul>
		</form>
	</div>
</dialog>

<script>
	import {
		findSearchResults,
		normalizeSearchText,
		parseSearchIndex,
		SEARCH_MIN_QUERY_LENGTH,
		type SearchEntry,
		type SearchEntryKind,
	} from '../../lib/search/search-match';

	interface SearchCopy {
		readonly kinds: Readonly<Record<SearchEntryKind, string>>;
		readonly loading: string;
		readonly unavailable: string;
		readonly noResults: string;
		readonly countOne: string;
		readonly countOther: string;
		readonly newTab: string;
	}

	function createResultItem(entry: SearchEntry, copy: SearchCopy): HTMLLIElement {
		const item = document.createElement('li');
		const link = document.createElement('a');
		link.className = 'site-search-result';
		link.href = entry.url;
		if (entry.external) {
			link.target = '_blank';
			link.rel = 'noreferrer';
		}

		const parts: [string, string][] = [
			['site-search-result__kind', copy.kinds[entry.kind]],
			['site-search-result__title', entry.title],
			['site-search-result__summary', entry.summary],
		];
		if (entry.external) parts.push(['site-search-result__hint', copy.newTab]);

		for (const [className, text] of parts) {
			if (!text) continue;
			const span = document.createElement('span');
			span.className = className;
			span.textContent = text;
			link.append(span);
		}

		item.append(link);
		return item;
	}

	document.querySelectorAll<HTMLDialogElement>('[data-search-dialog]').forEach((dialog) => {
		if (dialog.dataset.searchReady === 'true') return;

		const button = document.querySelector<HTMLButtonElement>('[data-search-button]');
		const closeButton = dialog.querySelector<HTMLButtonElement>('[data-search-close]');
		const input = dialog.querySelector<HTMLInputElement>('[data-search-input]');
		const panel = dialog.querySelector<HTMLElement>('.site-search-dialog__inner');
		const form = dialog.querySelector<HTMLFormElement>('[data-search-form]');
		const status = dialog.querySelector<HTMLElement>('[data-search-status]');
		const resultList = dialog.querySelector<HTMLUListElement>('[data-search-results]');
		const indexUrl = dialog.dataset.searchIndex;
		if (!button || !closeButton || !input || !panel || !form || !status || !resultList || !indexUrl) return;

		dialog.dataset.searchReady = 'true';
		const copy = JSON.parse(dialog.dataset.searchCopy ?? '{}') as SearchCopy;
		let closeFallback: number | undefined;
		let indexRequest: Promise<SearchEntry[]> | undefined;
		let renderSequence = 0;

		const loadIndex = (): Promise<SearchEntry[]> => {
			indexRequest ??= fetch(indexUrl, { headers: { Accept: 'application/json' } })
				.then((response) => {
					if (!response.ok) throw new Error(`Search index request failed with HTTP ${response.status}.`);
					return response.json() as Promise<unknown>;
				})
				.then(parseSearchIndex)
				.catch((error: unknown) => {
					indexRequest = undefined;
					throw error;
				});

			return indexRequest;
		};

		const showResults = (results: readonly SearchEntry[], query: string) => {
			resultList.replaceChildren(...results.map((entry) => createResultItem(entry, copy)));
			resultList.hidden = results.length === 0;
			status.textContent = results.length === 0
				? copy.noResults.replace('{query}', query.trim())
				: (results.length === 1 ? copy.countOne : copy.countOther).replace('{count}', String(results.length));
		};

		const clearResults = () => {
			resultList.replaceChildren();
			resultList.hidden = true;
			status.textContent = '';
		};

		const renderResults = () => {
			const sequence = ++renderSequence;
			const query = input.value;
			if (normalizeSearchText(query).length < SEARCH_MIN_QUERY_LENGTH) {
				clearResults();
				return;
			}

			if (!indexRequest) status.textContent = copy.loading;
			loadIndex()
				.then((entries) => {
					if (sequence === renderSequence) showResults(findSearchResults(entries, query), query);
				})
				.catch(() => {
					if (sequence !== renderSequence) return;
					resultList.replaceChildren();
					resultList.hidden = true;
					status.textContent = copy.unavailable;
				});
		};

		const resultLinks = () => Array.from(resultList.querySelectorAll<HTMLAnchorElement>('a'));

		input.addEventListener('input', renderResults);
		input.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown') return;
			const [first] = resultLinks();
			if (!first) return;
			event.preventDefault();
			first.focus();
		});
		resultList.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
			const links = resultLinks();
			const index = links.indexOf(document.activeElement as HTMLAnchorElement);
			if (index === -1) return;

			event.preventDefault();
			const next = event.key === 'ArrowDown' ? links[index + 1] : links[index - 1];
			(next ?? (event.key === 'ArrowUp' ? input : links[index])).focus();
		});
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const [first] = resultLinks();
			if (first) first.click();
		});

		const finishClose = () => {
			if (closeFallback !== undefined) window.clearTimeout(closeFallback);
			closeFallback = undefined;
			delete dialog.dataset.closing;
			if (dialog.open) dialog.close();
		};

		const closeSearch = () => {
			if (!dialog.open || dialog.dataset.closing !== undefined) return;

			dialog.dataset.closing = '';
			panel.addEventListener('animationend', finishClose, { once: true });
			closeFallback = window.setTimeout(finishClose, 650);
		};

		button.addEventListener('click', () => {
			delete dialog.dataset.closing;
			dialog.showModal();
			button.setAttribute('aria-expanded', 'true');
			requestAnimationFrame(() => input.focus());
			loadIndex().catch(() => undefined);
		});

		closeButton.addEventListener('click', closeSearch);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) closeSearch();
		});
		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeSearch();
		});
		dialog.addEventListener('close', () => {
			if (closeFallback !== undefined) window.clearTimeout(closeFallback);
			closeFallback = undefined;
			delete dialog.dataset.closing;
			renderSequence += 1;
			input.value = '';
			clearResults();
			button.setAttribute('aria-expanded', 'false');
			button.focus();
		});
	});
</script>

<style>
	.site-search-button {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		color: inherit;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.site-search-button svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
		transform: translateY(1px);
		transition: opacity 300ms ease-in-out;
	}

	.site-search-button:hover svg,
	.site-search-button:focus-visible svg {
		opacity: 0.6;
	}

	.site-search-form button svg {
		width: 1.25rem;
		height: 1.5rem;
		fill: currentColor;
	}

	.site-search-dialog {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		padding: 0;
		margin: 0;
		color: var(--color-ink);
		overflow: hidden;
		background: rgb(35 35 35 / 90%);
		border: 0;
	}

	.site-search-dialog::backdrop {
		background: transparent;
	}

	.site-search-dialog[open] {
		animation: site-search-scrim-in 200ms ease both;
	}

	.site-search-dialog[open][data-closing] {
		animation: site-search-scrim-out 200ms ease 400ms both;
	}

	.site-search-dialog__inner {
		position: relative;
		display: grid;
		min-height: min(28.125rem, 100dvh);
		max-height: 100dvh;
		place-items: center;
		padding: var(--space-8) var(--container-gutter);
		overflow-y: auto;
		background: var(--color-surface);
		will-change: opacity, transform;
		animation: site-search-panel-in 600ms ease both;
	}

	.site-search-dialog[data-closing] .site-search-dialog__inner {
		animation: site-search-panel-out 600ms ease both;
	}

	.site-search-dialog__close {
		position: absolute;
		top: 1.25rem;
		right: 1.5625rem;
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		color: var(--color-ink);
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.site-search-dialog__close span {
		display: block;
		font-size: 2.5rem;
		font-weight: 300;
		line-height: 1.1;
	}

	.site-search-form {
		width: 100%;
	}

	.site-search-form__label {
		display: block;
		margin-bottom: 2.21875rem;
		color: var(--color-ink);
		font-size: clamp(2.25rem, 5vw, 3.4375rem);
		font-weight: var(--font-weight-semibold);
		letter-spacing: -0.0625rem;
		line-height: 1;
	}

	.site-search-form__field {
		position: relative;
	}

	.site-search-form input {
		width: 100%;
		height: 4rem;
		padding: 1rem 2.375rem 1rem 0;
		color: var(--color-ink);
		font-size: 1.125rem;
		line-height: 1.875rem;
		background: transparent;
		border: 0;
		border-bottom: 2px solid rgb(0 0 0 / 10%);
		border-radius: 0;
		outline: 0;
	}

	.site-search-form input::placeholder {
		color: var(--color-text-muted);
	}

	.site-search-form button {
		position: absolute;
		top: 0;
		right: 0;
		display: grid;
		width: 1.875rem;
		height: 4rem;
		padding: 0 0.3125rem;
		place-items: center;
		color: var(--color-ink);
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.site-search-form input::-webkit-search-cancel-button {
		display: none;
	}

	.site-search-status {
		margin: 1.25rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.site-search-status:empty {
		display: none;
	}

	.site-search-results {
		display: grid;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.site-search-results[hidden] {
		display: none;
	}

	.site-search-results :global(.site-search-result) {
		display: grid;
		gap: 0.25rem;
		padding: 1rem 0;
		color: var(--color-ink);
		text-decoration: none;
		border-bottom: 1px solid var(--color-border);
	}

	.site-search-results :global(.site-search-result__kind) {
		color: var(--color-accent-action);
		font-size: 0.75rem;
		font-weight: var(--font-weight-semibold);
		letter-spacing: 0.05em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.site-search-results :global(.site-search-result__title) {
		font-size: 1.125rem;
		font-weight: var(--font-weight-semibold);
		line-height: 1.4;
		transition: color 300ms ease-in-out;
	}

	.site-search-results :global(.site-search-result:hover .site-search-result__title),
	.site-search-results :global(.site-search-result:focus-visible .site-search-result__title) {
		color: var(--color-accent-action);
	}

	.site-search-results :global(.site-search-result__summary) {
		display: -webkit-box;
		overflow: hidden;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.site-search-results :global(.site-search-result__hint) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 48rem) {
		.site-search-form {
			width: 45vw;
		}
	}

	@media (min-width: 62rem) {
		.site-search-button {
			width: 2.25rem;
		}
	}

	@keyframes site-search-scrim-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes site-search-scrim-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	@keyframes site-search-panel-in {
		from {
			opacity: 0;
			transform: translateY(-100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes site-search-panel-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(-100%);
		}
	}
</style>
