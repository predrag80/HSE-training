---
import type { Locale } from '../../i18n/config';
import { getAvailablePublicPath } from '../../i18n/routes';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = locale === 'sr'
	? {
		open: 'Otvori pretragu sajta',
		close: 'Zatvori pretragu sajta',
		question: 'Šta tražite?',
		placeholder: 'Unesite ključne reči...',
		submit: 'Pokreni pretragu',
	}
	: {
		open: 'Open site search',
		close: 'Close site search',
		question: 'What are you looking for?',
		placeholder: 'Enter your keywords...',
		submit: 'Submit search',
	};
---

<button
	class="site-search-button"
	type="button"
	aria-controls="site-search-dialog"
	aria-expanded="false"
	aria-label={copy.open}
	data-search-button
>
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<path d="M11 2C15.9706 2 20 6.02944 20 11C20 13.125 19.2619 15.0766 18.0303 16.6162L21.707 20.293L21.7764 20.3691C22.0963 20.7619 22.0729 21.3411 21.707 21.707C21.3411 22.073 20.7619 22.0963 20.3691 21.7764L20.293 21.707L16.6162 18.0303C15.0766 19.2619 13.125 20 11 20C6.02944 20 2 15.9706 2 11C2 6.02944 6.02944 2 11 2ZM11 4C7.13401 4 4 7.13401 4 11C4 14.866 7.13401 18 11 18C12.8905 18 14.6047 17.2492 15.8643 16.0312C15.8884 16.0007 15.9151 15.9716 15.9434 15.9434C15.9716 15.9151 16.0006 15.8884 16.0312 15.8643C17.2492 14.6047 18 12.8905 18 11C18 7.13401 14.866 4 11 4Z"></path>
	</svg>
</button>

<dialog
	class="site-search-dialog"
	id="site-search-dialog"
	aria-labelledby="site-search-title"
	data-search-dialog
>
	<div class="site-search-dialog__inner">
		<button class="site-search-dialog__close" type="button" aria-label={copy.close} data-search-close>
			<span aria-hidden="true">×</span>
		</button>

		<form class="site-search-form" action={getAvailablePublicPath('/courses/', locale)} method="get" role="search">
			<label class="site-search-form__label" id="site-search-title" for="site-search-query">
				{copy.question}
			</label>
			<div class="site-search-form__field">
				<input
					id="site-search-query"
					name="q"
					type="search"
					placeholder={copy.placeholder}
					autocomplete="off"
					required
					data-search-input
				/>
				<button type="submit" aria-label={copy.submit}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M11 2C15.9706 2 20 6.02944 20 11C20 13.125 19.2619 15.0766 18.0303 16.6162L21.707 20.293L21.7764 20.3691C22.0963 20.7619 22.0729 21.3411 21.707 21.707C21.3411 22.073 20.7619 22.0963 20.3691 21.7764L20.293 21.707L16.6162 18.0303C15.0766 19.2619 13.125 20 11 20C6.02944 20 2 15.9706 2 11C2 6.02944 6.02944 2 11 2ZM11 4C7.13401 4 4 7.13401 4 11C4 14.866 7.13401 18 11 18C12.8905 18 14.6047 17.2492 15.8643 16.0312C15.8884 16.0007 15.9151 15.9716 15.9434 15.9434C15.9716 15.9151 16.0006 15.8884 16.0312 15.8643C17.2492 14.6047 18 12.8905 18 11C18 7.13401 14.866 4 11 4Z"></path>
					</svg>
				</button>
			</div>
		</form>
	</div>
</dialog>

<script>
	document.querySelectorAll<HTMLDialogElement>('[data-search-dialog]').forEach((dialog) => {
		if (dialog.dataset.searchReady === 'true') return;

		const button = document.querySelector<HTMLButtonElement>('[data-search-button]');
		const closeButton = dialog.querySelector<HTMLButtonElement>('[data-search-close]');
		const input = dialog.querySelector<HTMLInputElement>('[data-search-input]');
		const panel = dialog.querySelector<HTMLElement>('.site-search-dialog__inner');
		if (!button || !closeButton || !input || !panel) return;

		dialog.dataset.searchReady = 'true';
		let closeFallback: number | undefined;

		const finishClose = () => {
			if (closeFallback !== undefined) window.clearTimeout(closeFallback);
			closeFallback = undefined;
			delete dialog.dataset.closing;
			if (dialog.open) dialog.close();
		};

		const closeSearch = () => {
			if (!dialog.open || dialog.dataset.closing !== undefined) return;

			dialog.dataset.closing = '';
			panel.addEventListener('animationend', finishClose, { once: true });
			closeFallback = window.setTimeout(finishClose, 650);
		};

		button.addEventListener('click', () => {
			delete dialog.dataset.closing;
			dialog.showModal();
			button.setAttribute('aria-expanded', 'true');
			requestAnimationFrame(() => input.focus());
		});

		closeButton.addEventListener('click', closeSearch);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) closeSearch();
		});
		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeSearch();
		});
		dialog.addEventListener('close', () => {
			if (closeFallback !== undefined) window.clearTimeout(closeFallback);
			closeFallback = undefined;
			delete dialog.dataset.closing;
			button.setAttribute('aria-expanded', 'false');
			button.focus();
		});
	});
</script>

<style>
	.site-search-button {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		color: inherit;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.site-search-button svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
		transform: translateY(1px);
		transition: opacity 300ms ease-in-out;
	}

	.site-search-button:hover svg,
	.site-search-button:focus-visible svg {
		opacity: 0.6;
	}

	.site-search-form button svg {
		width: 1.25rem;
		height: 1.5rem;
		fill: currentColor;
	}

	.site-search-dialog {
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		padding: 0;
		margin: 0;
		color: var(--color-ink);
		overflow: hidden;
		background: rgb(35 35 35 / 90%);
		border: 0;
	}

	.site-search-dialog::backdrop {
		background: transparent;
	}

	.site-search-dialog[open] {
		animation: site-search-scrim-in 200ms ease both;
	}

	.site-search-dialog[open][data-closing] {
		animation: site-search-scrim-out 200ms ease 400ms both;
	}

	.site-search-dialog__inner {
		position: relative;
		display: grid;
		height: min(28.125rem, 100dvh);
		place-items: center;
		padding: var(--space-8) var(--container-gutter);
		background: var(--color-surface);
		will-change: opacity, transform;
		animation: site-search-panel-in 600ms ease both;
	}

	.site-search-dialog[data-closing] .site-search-dialog__inner {
		animation: site-search-panel-out 600ms ease both;
	}

	.site-search-dialog__close {
		position: absolute;
		top: 1.25rem;
		right: 1.5625rem;
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		place-items: center;
		color: var(--color-ink);
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.site-search-dialog__close span {
		display: block;
		font-size: 2.5rem;
		font-weight: 300;
		line-height: 1.1;
	}

	.site-search-form {
		width: 100%;
	}

	.site-search-form__label {
		display: block;
		margin-bottom: 2.21875rem;
		color: var(--color-ink);
		font-size: clamp(2.25rem, 5vw, 3.4375rem);
		font-weight: var(--font-weight-semibold);
		letter-spacing: -0.0625rem;
		line-height: 1;
	}

	.site-search-form__field {
		position: relative;
	}

	.site-search-form input {
		width: 100%;
		height: 4rem;
		padding: 1rem 2.375rem 1rem 0;
		color: var(--color-ink);
		font-size: 1.125rem;
		line-height: 1.875rem;
		background: transparent;
		border: 0;
		border-bottom: 2px solid rgb(0 0 0 / 10%);
		border-radius: 0;
		outline: 0;
	}

	.site-search-form input::placeholder {
		color: var(--color-text-muted);
	}

	.site-search-form button {
		position: absolute;
		top: 0;
		right: 0;
		display: grid;
		width: 1.875rem;
		height: 4rem;
		padding: 0 0.3125rem;
		place-items: center;
		color: var(--color-ink);
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.site-search-form input::-webkit-search-cancel-button {
		display: none;
	}

	@media (min-width: 48rem) {
		.site-search-form {
			width: 45vw;
		}
	}

	@media (min-width: 62rem) {
		.site-search-button {
			width: 2.25rem;
		}
	}

	@keyframes site-search-scrim-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes site-search-scrim-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	@keyframes site-search-panel-in {
		from {
			opacity: 0;
			transform: translateY(-100%);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes site-search-panel-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(-100%);
		}
	}
</style>
