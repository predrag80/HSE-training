---
import HeaderSocialLinks from './HeaderSocialLinks.astro';
import type { Locale } from '../../i18n/config';
import { getAvailablePublicPath, getDefaultLocalePath } from '../../i18n/routes';
import { getUiTranslations } from '../../i18n/ui';

interface Props {
	pathname: string;
	locale: Locale;
}

const { pathname, locale } = Astro.props;
const routePath = getDefaultLocalePath(pathname);
const isHome = routePath === '/';
const neboshCurrent = routePath.startsWith('/nebosh');
const otherCoursesCurrent = routePath.startsWith('/other-courses') || routePath.startsWith('/banksman-slinger') || routePath.startsWith('/train-the-trainer');
const ui = getUiTranslations(locale);
const path = (value: string) => getAvailablePublicPath(value, locale);
const links = [
	{ label: ui.navigation.home, href: path('/'), current: routePath === '/' },
	{ label: ui.navigation.company, href: path('/company/'), current: routePath.startsWith('/company') },
	{
		label: ui.navigation.nebosh,
		href: path('/nebosh/'),
		current: neboshCurrent,
		children: [
			{
				label: ui.navigation.neboshIgc,
				href: path('/nebosh-international-general-certificate-in-occupational-health-and-safety/'),
				current: routePath.startsWith('/nebosh-international-general-certificate-in-occupational-health-and-safety'),
			},
			{
				label: ui.navigation.neboshIogc,
				href: path('/nebosh-international-oilgas-certificate/'),
				current: routePath.startsWith('/nebosh-international-oilgas-certificate'),
			},
		],
	},
	{
		label: ui.navigation.otherCourses,
		href: path('/other-courses/'),
		current: otherCoursesCurrent,
		children: [
			{
				label: ui.navigation.banksmanSlinger,
				href: path('/banksman-slinger/'),
				current: routePath.startsWith('/banksman-slinger'),
			},
			{
				label: ui.navigation.trainTheTrainer,
				href: path('/train-the-trainer/'),
				current: routePath.startsWith('/train-the-trainer'),
			},
		],
	},
	{ label: ui.navigation.consulting, href: path('/consulting/'), current: routePath.startsWith('/consulting') },
	{ label: ui.navigation.gallery, href: path('/gallery/'), current: routePath.startsWith('/gallery') },
	{ label: ui.navigation.reference, href: isHome ? '#reference' : `${path('/')}#reference`, current: false },
	{ label: ui.navigation.contact, href: path('/contact/'), current: routePath.startsWith('/contact') },
];
---

<nav class="site-nav" id="site-navigation" aria-label={ui.primaryNavigation} data-site-navigation>
	<ul class="site-nav__list">
		{
			links.map((link) => (
				<li class:list={['site-nav__item', { 'site-nav__item--has-submenu': link.children }]}>
					<div class="site-nav__item-row">
						<a class="site-nav__link" href={link.href} aria-current={link.current ? 'page' : undefined}>
							{link.label}
						</a>
						{link.children && (
							<button class="site-nav__submenu-toggle" type="button" aria-expanded="false" aria-label={`${ui.toggleSubmenu} ${link.label}`} data-submenu-toggle>
								<svg viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5" /></svg>
							</button>
						)}
					</div>
					{link.children && (
						<ul class="site-nav__submenu" data-submenu>
							{link.children.map((child) => (
								<li><a href={child.href} aria-current={child.current ? 'page' : undefined}>{child.label}</a></li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ul>
	<HeaderSocialLinks variant="mobile" {locale} />
</nav>

<script>
	const desktopNavigation = window.matchMedia('(min-width: 62rem)');

	document.querySelectorAll<HTMLElement>('[data-site-navigation]').forEach((navigation) => {
		if (navigation.dataset.submenuReady === 'true') return;
		navigation.dataset.submenuReady = 'true';

		const toggles = navigation.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]');
		const closeSubmenus = () => {
			toggles.forEach((toggle) => {
				toggle.setAttribute('aria-expanded', 'false');
				toggle.closest<HTMLElement>('.site-nav__item')?.removeAttribute('data-submenu-open');
			});
		};

		toggles.forEach((toggle) => {
			toggle.addEventListener('click', () => {
				if (desktopNavigation.matches) return;
				const item = toggle.closest<HTMLElement>('.site-nav__item');
				if (!item) return;
				const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
				closeSubmenus();
				toggle.setAttribute('aria-expanded', String(willOpen));
				item.toggleAttribute('data-submenu-open', willOpen);
			});
		});

		navigation.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			const openToggle = navigation.querySelector<HTMLButtonElement>('[data-submenu-toggle][aria-expanded="true"]');
			if (!openToggle) return;
			closeSubmenus();
			openToggle.focus();
		});

		desktopNavigation.addEventListener('change', closeSubmenus);
	});
</script>

<style>
	.site-nav {
		position: absolute;
		top: 100%;
		left: calc(-1 * var(--header-gutter));
		display: none;
		width: calc(100% + (2 * var(--header-gutter)));
		max-height: calc(100dvh - 5rem);
		overflow-y: auto;
		background: var(--color-surface);
		border-top: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
	}

	.site-nav[data-open] { display: block; }
	.site-nav__list { padding: var(--space-2) var(--header-gutter) var(--space-4); margin: 0; list-style: none; }
	.site-nav__item,
	.site-nav__submenu li { max-width: none; }
	.site-nav__item-row { display: flex; border-bottom: 1px solid var(--color-border); }

	.site-nav__link {
		display: flex;
		min-height: 3.125rem;
		flex: 1;
		align-items: center;
		padding-inline: var(--space-3);
		color: var(--color-ink);
		font-size: 1rem;
		font-weight: var(--font-weight-regular);
		line-height: 1;
		text-decoration: none;
		text-transform: none;
		transition: color var(--transition-base), opacity var(--transition-base);
	}

	.site-nav__link:hover,
	.site-nav__link:focus-visible,
	.site-nav__link[aria-current='page'] { color: var(--color-accent-action); }

	.site-nav__submenu-toggle {
		display: grid;
		width: 3.125rem;
		padding: 0;
		place-items: center;
		color: var(--color-ink);
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.site-nav__submenu-toggle svg { width: 0.75rem; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform 300ms ease; }
	.site-nav__submenu-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
	.site-nav__submenu { display: none; padding: 0.375rem 0 0.75rem 1rem; margin: 0; list-style: none; }
	.site-nav__item[data-submenu-open] > .site-nav__submenu { display: block; }
	.site-nav__submenu a {
		display: flex;
		min-height: 2.75rem;
		align-items: center;
		padding-inline: 0.75rem;
		color: var(--color-ink-muted);
		font-size: 0.9375rem;
		text-decoration: none;
		text-transform: none;
	}
	.site-nav__submenu a:hover,
	.site-nav__submenu a:focus-visible,
	.site-nav__submenu a[aria-current='page'] { color: var(--color-accent-action); }

	@media (min-width: 62rem) {
		.site-nav { position: static; display: block; width: auto; max-height: none; overflow: visible; background: transparent; border: 0; box-shadow: none; }
		.site-nav__list { display: flex; align-items: stretch; padding: 0; }
		.site-nav__item { position: relative; }
		.site-nav__item-row { height: 100%; border: 0; }
		.site-nav__link { min-height: 5.9375rem; padding-inline: 1rem; color: var(--header-foreground); font-size: 1.0625rem; border: 0; }
		.site-nav__link:hover,
		.site-nav__link:focus-visible,
		.site-nav__link[aria-current='page'] { color: var(--header-foreground); opacity: 0.62; }
		.site-nav__submenu-toggle { display: none; }
		.site-nav__item--has-submenu > .site-nav__item-row > .site-nav__link::after {
			width: 0.375rem;
			height: 0.375rem;
			margin: -0.1875rem 0 0 0.45rem;
			content: '';
			border-right: 1px solid currentColor;
			border-bottom: 1px solid currentColor;
			transform: rotate(45deg);
		}
		.site-nav__submenu {
			position: absolute;
			top: calc(100% - 0.0625rem);
			left: 0;
			display: block;
			width: 16.5rem;
			padding: 1.15rem 0;
			visibility: hidden;
			opacity: 0;
			background: #fff;
			box-shadow: 0 0.625rem 2.1875rem rgb(0 0 0 / 10%);
			transform: translateY(0.75rem);
			transition: opacity 250ms ease, transform 250ms ease, visibility 250ms ease;
		}
		.site-nav__item--has-submenu:hover > .site-nav__submenu,
		.site-nav__item--has-submenu:focus-within > .site-nav__submenu { visibility: visible; opacity: 1; transform: translateY(0); }
		.site-nav__submenu a { min-height: 2.5rem; padding: 0.35rem 1.875rem; color: #6b6e7b; font-size: 0.9375rem; line-height: 1.35; transition: color 250ms ease, transform 250ms ease; }
		.site-nav__submenu a:hover,
		.site-nav__submenu a:focus-visible,
		.site-nav__submenu a[aria-current='page'] { color: #dd6531; transform: translateX(0.25rem); }
	}

	@media (min-width: 62rem) and (max-width: 74.999rem) {
		.site-nav__link { padding-inline: 0.5rem; font-size: 0.875rem; }
	}

	@media (min-width: 75rem) {
		.site-nav__link { padding-inline: 1.25rem; font-size: 1.125rem; }
	}
</style>
