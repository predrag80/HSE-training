---
import { localeMetadata, locales, type Locale } from '../../i18n/config';
import { getLanguageAlternates } from '../../i18n/routes';
import { getUiTranslations } from '../../i18n/ui';

interface Props {
	locale: Locale;
	pathname: string;
	alternates?: Readonly<Record<Locale, string>>;
	variant?: 'main' | 'utility';
}

const { locale, pathname, alternates: suppliedAlternates, variant = 'main' } = Astro.props;
const alternates = suppliedAlternates ?? getLanguageAlternates(pathname);
const ui = getUiTranslations(locale);
---

<nav class:list={['language-switcher', `language-switcher--${variant}`]} aria-label={ui.languageNavigation}>
	<ul>
		{locales.map((itemLocale) => {
			const metadata = localeMetadata[itemLocale];
			const isCurrent = itemLocale === locale;

			return (
				<li>
					<a
						class="language-switcher__link"
						href={alternates[itemLocale]}
						hreflang={itemLocale}
						lang={metadata.htmlLang}
						aria-current={isCurrent ? 'page' : undefined}
						aria-label={`${metadata.label}${isCurrent ? ` — ${ui.currentLanguage}` : ''}`}
						title={metadata.label}
					>
						<img src={`/images/flags/${itemLocale === 'en' ? 'gb' : 'rs'}.svg`} width="24" height="14" alt="" />
						<span class="language-switcher__label">{metadata.shortLabel}</span>
					</a>
				</li>
			);
		})}
	</ul>
</nav>

<style>
	.language-switcher ul {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.language-switcher li {
		max-width: none;
	}

	.language-switcher__link {
		position: relative;
		display: grid;
		width: 1.625rem;
		height: 2.75rem;
		place-items: center;
		color: inherit;
		text-decoration: none;
	}

	.language-switcher__link img {
		display: block;
		width: 1.25rem;
		height: 0.75rem;
		object-fit: cover;
		border: 1px solid rgb(255 255 255 / 52%);
		box-shadow: 0 1px 3px rgb(0 0 0 / 18%);
		transition: opacity 250ms ease, transform 250ms ease;
	}

	.language-switcher__link:hover img,
	.language-switcher__link:focus-visible img {
		opacity: 0.72;
		transform: translateY(-1px);
	}

	.language-switcher__link[aria-current='page']::after {
		position: absolute;
		bottom: 0.35rem;
		left: 50%;
		width: 1rem;
		height: 1px;
		content: '';
		background: currentColor;
		transform: translateX(-50%);
	}

	.language-switcher__label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.language-switcher--utility {
		display: none;
	}

	@media (min-width: 48rem) {
		.language-switcher--main {
			display: none;
		}

		.language-switcher--utility {
			display: block;
		}

		.language-switcher--utility .language-switcher__link {
			height: 2.25rem;
		}

		.language-switcher--utility .language-switcher__link[aria-current='page']::after {
			bottom: 0.15rem;
		}
	}
</style>
