</div>

<style>
	.header-socials p { margin: 0 0 0.85rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; }
	.header-socials ul { display: flex; gap: 0.65rem; padding: 0; margin: 0; list-style: none; }
	.header-socials li { max-width: none; }
	.header-socials a { display: grid; width: 2.35rem; height: 2.35rem; place-items: center; border: 1px solid currentColor; border-radius: 50%; text-decoration: none; transition: color 300ms ease, background 300ms ease, border-color 300ms ease, transform 300ms ease; }
	.header-socials svg { width: 0.9rem; height: 0.9rem; fill: currentColor; }
	.header-socials a:hover,
	.header-socials a:focus-visible { transform: translateY(-0.2rem); }

	.header-socials--drawer { padding-top: 1.6rem; color: var(--color-text-on-strong-muted); border-top: 1px solid var(--color-border-on-strong); }
	.header-socials--drawer a { color: var(--color-text-on-strong); border-color: rgb(255 255 255 / 24%); }
	.header-socials--drawer a:hover,
	.header-socials--drawer a:focus-visible { color: var(--color-ink); background: var(--color-surface); border-color: var(--color-surface); }

	.header-socials--mobile { padding: 1.35rem var(--header-gutter) 1.65rem; color: var(--color-ink-muted); }
	.header-socials--mobile a { color: var(--color-ink); border-color: var(--color-border); }
	.header-socials--mobile a:hover,
	.header-socials--mobile a:focus-visible { color: #fff; background: #dd6531; border-color: #dd6531; }

	@media (min-width: 62rem) {
		.header-socials--mobile { display: none; }
	}
</style>
