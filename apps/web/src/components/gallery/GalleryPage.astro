---
import './gallery-page.css';
import type { Locale } from '../../i18n/config';
import { getGalleryUiTranslations } from '../../i18n/gallery-ui';

interface Props { readonly locale: Locale; }
const { locale } = Astro.props;
const copy = getGalleryUiTranslations(locale);

const images = [
	'IMG_3052',
	'IMG_3023',
	'IMG_3001',
	'IMG_2976',
	'IMG_2957',
	'IMG_2896',
	'IMG_2898',
	'IMG_2925',
	'IMG_2934',
	'IMG_2851',
	'IMG_2819',
	'IMG_2807',
	'IMG_2802',
	'IMG_2800',
	'8-2',
	'8-4',
	'9-2',
	'9-3',
	'IMG_2767',
	'7-5',
	'7-1',
	'6-1',
	'5-6',
	'4-3-1',
].map((name, index) => ({
	src: `/images/gallery/${name}.webp`,
	alt: `${copy.photoAlt} ${index + 1}`,
	featured: index % 7 === 0,
}));
---

<section class="gallery-hero" aria-labelledby="gallery-title" data-gallery-parallax>
	<div class="gallery-hero__overlay" aria-hidden="true"></div>
	<div class="gallery-hero__content" data-gallery-reveal="hero">
		<p>{copy.heroEyebrow}</p>
		<h1 id="gallery-title">{copy.heroTitle}</h1>
	</div>
	<a class="gallery-hero__scroll" href="#training-gallery" aria-label={copy.heroScroll}><span></span></a>
</section>

<section class="training-gallery" id="training-gallery" aria-labelledby="training-gallery-title">
	<div class="gallery-container">
		<header class="training-gallery__heading" data-gallery-reveal="up">
			<div>
				<p>{copy.headingEyebrow}</p>
				<h2 id="training-gallery-title">{copy.headingTitle}</h2>
			</div>
			<span>{copy.headingText}</span>
		</header>

		<div class="training-gallery__grid">
			{images.map((image, index) => (
				<button
					class:list={['training-gallery__item', { 'training-gallery__item--featured': image.featured }]}
					type="button"
					data-gallery-item
					data-gallery-src={image.src}
					data-gallery-alt={image.alt}
					data-gallery-index={index}
					aria-label={`${copy.openPhoto} ${index + 1} ${copy.of} ${images.length}`}
					data-gallery-reveal="up"
				>
					<img src={image.src} width="1600" height="1067" alt={image.alt} loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
					<span class="training-gallery__overlay" aria-hidden="true"><i></i></span>
				</button>
			))}
		</div>
	</div>
</section>

<dialog class="gallery-lightbox" data-gallery-lightbox aria-label={copy.lightboxLabel}>
	<div class="gallery-lightbox__stage">
		<button class="gallery-lightbox__close" type="button" aria-label={copy.close} data-gallery-close>
			<span></span><span></span>
		</button>
		<button class="gallery-lightbox__arrow gallery-lightbox__arrow--previous" type="button" aria-label={copy.previous} data-gallery-previous>←</button>
		<figure>
			<img src="/images/gallery/IMG_3052.webp" alt="" width="1600" height="1067" data-gallery-lightbox-image />
			<figcaption data-gallery-caption>1 / {images.length}</figcaption>
		</figure>
		<button class="gallery-lightbox__arrow gallery-lightbox__arrow--next" type="button" aria-label={copy.next} data-gallery-next>→</button>
	</div>
</dialog>

<script>
	const revealTargets = document.querySelectorAll<HTMLElement>('[data-gallery-reveal]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (reduceMotion || !('IntersectionObserver' in window)) {
		revealTargets.forEach((target) => target.setAttribute('data-revealed', 'true'));
	} else {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				(entry.target as HTMLElement).setAttribute('data-revealed', 'true');
				observer.unobserve(entry.target);
			});
		}, { threshold: 0.1 });
		revealTargets.forEach((target) => observer.observe(target));
	}

	const hero = document.querySelector<HTMLElement>('[data-gallery-parallax]');
	let parallaxFrame = 0;
	if (hero && !reduceMotion) {
		window.addEventListener('scroll', () => {
			if (parallaxFrame) return;
			parallaxFrame = window.requestAnimationFrame(() => {
				hero.style.setProperty('--gallery-hero-shift', `${Math.min(window.scrollY * 0.42, 210)}px`);
				parallaxFrame = 0;
			});
		}, { passive: true });
	}

	const lightbox = document.querySelector<HTMLDialogElement>('[data-gallery-lightbox]');
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-gallery-lightbox-image]');
	const caption = lightbox?.querySelector<HTMLElement>('[data-gallery-caption]');
	const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));
	let activeIndex = 0;

	const displayImage = (index: number) => {
		if (!lightboxImage || !caption || !items.length) return;
		activeIndex = (index + items.length) % items.length;
		const item = items[activeIndex];
		lightboxImage.src = item.dataset.gallerySrc ?? '';
		lightboxImage.alt = item.dataset.galleryAlt ?? '';
		caption.textContent = `${activeIndex + 1} / ${items.length}`;
	};

	items.forEach((item, index) => {
		item.addEventListener('click', () => {
			displayImage(index);
			lightbox?.showModal();
			document.body.style.overflow = 'hidden';
		});
	});

	lightbox?.querySelector('[data-gallery-close]')?.addEventListener('click', () => lightbox.close());
	lightbox?.querySelector('[data-gallery-previous]')?.addEventListener('click', () => displayImage(activeIndex - 1));
	lightbox?.querySelector('[data-gallery-next]')?.addEventListener('click', () => displayImage(activeIndex + 1));
	lightbox?.addEventListener('close', () => { document.body.style.overflow = ''; });
	lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
	lightbox?.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowLeft') displayImage(activeIndex - 1);
		if (event.key === 'ArrowRight') displayImage(activeIndex + 1);
	});
</script>
