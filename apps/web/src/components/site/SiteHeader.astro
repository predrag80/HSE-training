---
import Container from '../ui/Container.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isCourses = pathname.startsWith('/courses');
const aboutHref = isHome ? '#about' : '/#about';
const contactHref = isHome ? '#contact' : '/#contact';
---

<header class="site-header">
	<div class="site-header__utility">
		<Container>
			<div class="utility-content">
				<p>Health, safety and environmental training</p>
				<div class="utility-links">
					<a href="tel:+381615335010">+381 61 5335 010</a>
					<a href="mailto:info@hsetraining.rs">info@hsetraining.rs</a>
				</div>
			</div>
		</Container>
	</div>

	<div class="site-header__navigation">
		<Container>
			<div class="navigation-content">
				<a class="brand" href="/" aria-label="HSE Training home">
					<svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">
						<path d="M24 3 42 10v12c0 11-7.3 19.4-18 23C13.3 41.4 6 33 6 22V10l18-7Z"></path>
						<path d="m15.5 24 5.3 5.2L32.8 17"></path>
					</svg>
					<span class="brand__text">
						<strong>HSE</strong>
						<span>Training</span>
					</span>
				</a>

				<nav class="desktop-nav" aria-label="Main navigation">
					<a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
					<a href="/courses" aria-current={isCourses ? 'page' : undefined}>Courses</a>
					<a href={aboutHref}>About</a>
					<a href={contactHref}>Contact</a>
				</nav>

				<details class="mobile-nav">
					<summary>
						<span class="mobile-nav__label">Menu</span>
						<span class="mobile-nav__icon" aria-hidden="true">
							<span></span>
						</span>
					</summary>
					<nav aria-label="Mobile navigation">
						<a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
						<a href="/courses" aria-current={isCourses ? 'page' : undefined}>Courses</a>
						<a href={aboutHref}>About</a>
						<a href={contactHref}>Contact</a>
					</nav>
				</details>
			</div>
		</Container>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 20;
	}

	.site-header__utility {
		display: none;
		color: var(--color-text-muted);
		font-size: var(--font-size-small);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.utility-content,
	.utility-links,
	.navigation-content,
	.brand,
	.desktop-nav {
		display: flex;
		align-items: center;
	}

	.utility-content {
		min-height: 2.8125rem;
		justify-content: flex-end;
	}

	.utility-content p {
		display: none;
		margin: 0;
	}

	.utility-links {
		gap: var(--space-4);
	}

	.utility-links a {
		color: inherit;
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}

	.utility-links a:hover {
		color: var(--color-accent-action);
	}

	.site-header__navigation {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.navigation-content {
		position: relative;
		min-height: 5rem;
		justify-content: space-between;
		gap: var(--space-5);
	}

	.brand {
		gap: var(--space-3);
		color: var(--color-brand-strong);
		text-decoration: none;
	}

	.brand__mark {
		width: 2.625rem;
		height: 2.625rem;
		fill: var(--color-brand-strong);
	}

	.brand__mark path + path {
		fill: none;
		stroke: var(--color-accent-on-strong);
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 3.5;
	}

	.brand__text {
		display: grid;
		line-height: 1;
		text-transform: uppercase;
	}

	.brand__text strong {
		font-size: 1.25rem;
		letter-spacing: 0.08em;
	}

	.brand__text span {
		margin-top: var(--space-1);
		color: var(--color-text-muted);
		font-size: 0.6875rem;
		font-weight: var(--font-weight-bold);
		letter-spacing: 0.18em;
	}

	.desktop-nav {
		display: none;
		gap: var(--space-6);
	}

	.desktop-nav a {
		position: relative;
		padding-block: var(--space-3);
		color: var(--color-brand-strong);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}

	.desktop-nav a::after {
		position: absolute;
		inset: auto 0 0;
		height: 0.125rem;
		content: '';
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-fast);
	}

	.desktop-nav a:hover::after,
	.desktop-nav a:focus-visible::after,
	.desktop-nav a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.mobile-nav summary {
		display: grid;
		min-width: 2.75rem;
		min-height: 2.75rem;
		place-items: center;
		color: var(--color-brand-strong);
		list-style: none;
		cursor: pointer;
	}

	.mobile-nav summary::-webkit-details-marker {
		display: none;
	}

	.mobile-nav__label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.mobile-nav__icon::before,
	.mobile-nav__icon::after,
	.mobile-nav__icon span {
		display: block;
		width: 1.5rem;
		height: 0.125rem;
		background: currentColor;
		transition:
			transform var(--transition-base),
			opacity var(--transition-base);
	}

	.mobile-nav__icon {
		position: relative;
		display: block;
		width: 1.5rem;
		height: 0.125rem;
	}

	.mobile-nav__icon::before,
	.mobile-nav__icon::after {
		position: absolute;
		left: 0;
		content: '';
	}

	.mobile-nav__icon::before {
		top: -0.4375rem;
	}

	.mobile-nav__icon::after {
		top: 0.4375rem;
	}

	.mobile-nav[open] .mobile-nav__icon span {
		opacity: 0;
	}

	.mobile-nav[open] .mobile-nav__icon::before {
		transform: translateY(0.4375rem) rotate(45deg);
	}

	.mobile-nav[open] .mobile-nav__icon::after {
		transform: translateY(-0.4375rem) rotate(-45deg);
	}

	.mobile-nav nav {
		position: absolute;
		top: 100%;
		right: 0;
		left: 0;
		display: grid;
		padding: var(--space-3) var(--container-gutter) var(--space-5);
		background: var(--color-surface);
		border-block: 1px solid var(--color-border);
		box-shadow: var(--shadow-card);
	}

	.mobile-nav:not([open]) nav {
		display: none;
	}

	.mobile-nav nav a {
		min-height: 3rem;
		padding: var(--space-3);
		color: var(--color-brand-strong);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
		border-bottom: 1px solid var(--color-border);
	}

	.mobile-nav nav a[aria-current='page'] {
		color: var(--color-accent);
	}

	@media (min-width: 48rem) {
		.site-header__utility {
			display: block;
		}

		.utility-content {
			justify-content: space-between;
		}

		.utility-content p {
			display: block;
		}

	}

	@media (min-width: 64rem) {
		.navigation-content {
			min-height: 5.9375rem;
		}

		.desktop-nav {
			display: flex;
			gap: 0;
		}

		.desktop-nav a {
			padding-inline: var(--space-5);
		}

		.mobile-nav {
			display: none;
		}
	}
</style>
