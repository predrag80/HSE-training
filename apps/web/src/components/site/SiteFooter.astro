---
import './site-footer.css';
import type { Locale } from '../../i18n/config';
import { getAvailablePublicPath } from '../../i18n/routes';
import { getUiTranslations } from '../../i18n/ui';
import { contactDetails } from '../../lib/contact';

interface Props {
	readonly locale: Locale;
}

const { locale } = Astro.props;
const copy = getUiTranslations(locale).footer;
const path = (value: string) => getAvailablePublicPath(value, locale);
const referencePath = `${path('/')}#reference`;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__main">
		<div class="site-footer__column site-footer__about">
			<a class="site-footer__logo" href={path('/')} aria-label={copy.homeLabel}>
				<img src="/images/hse-training-logo.png" width="410" height="136" alt={`${contactDetails.companyName} Belgrade`} />
			</a>
			<p>{copy.description}</p>
			<ul class="site-footer__socials" aria-label={copy.socialLabel}>
				<li><a href="https://www.facebook.com/neboshserbia/" target="_blank" rel="noreferrer" aria-label="Facebook"><svg aria-hidden="true" viewBox="0 0 320 512"><path d="M80 299.3V512h116V299.3h86.5l18-97.8H196v-34.6c0-51.7 20.3-71.5 72.7-71.5 16.3 0 29.4.4 37 1.2V7.9C291.4 4 256.4 0 236.2 0 129.3 0 80 50.5 80 159.4v42.1H14v97.8h66Z" /></svg></a></li>
				<li><a href="https://www.linkedin.com/company/10871567/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><svg aria-hidden="true" viewBox="0 0 448 512"><path d="M100.3 448H7.4V148.9h92.9V448ZM53.8 108.1C24.1 108.1 0 83.5 0 53.8A53.8 53.8 0 0 1 107.6 53.8c0 29.7-24.1 54.3-53.8 54.3ZM447.9 448h-92.7V302.4c0-34.7-.7-79.2-48.3-79.2-48.3 0-55.7 37.7-55.7 76.7V448h-92.8V148.9h89.1v40.8h1.3c12.4-23.5 42.7-48.3 87.9-48.3 94 0 111.3 61.9 111.3 142.3V448Z" /></svg></a></li>
				<li><a href="https://www.instagram.com/nebosh.serbia" target="_blank" rel="noreferrer" aria-label="Instagram"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1"/></svg></a></li>
				<li><a href="https://www.youtube.com/@HSESAFETYCOACH" target="_blank" rel="noreferrer" aria-label="YouTube"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21.2 7.1a2.9 2.9 0 0 0-2-2C17.4 4.6 12 4.6 12 4.6s-5.4 0-7.2.5a2.9 2.9 0 0 0-2 2A30 30 0 0 0 2.3 12a30 30 0 0 0 .5 4.9 2.9 2.9 0 0 0 2 2c1.8.5 7.2.5 7.2.5s5.4 0 7.2-.5a2.9 2.9 0 0 0 2-2 30 30 0 0 0 .5-4.9 30 30 0 0 0-.5-4.9ZM10 15.2V8.8l5.5 3.2-5.5 3.2Z" /></svg></a></li>
			</ul>
		</div>

		<nav class="site-footer__column site-footer__company" aria-label={copy.navigationLabel}>
			<h2>{copy.explore}</h2>
			<ul>
				<li><a href={path('/company/')}>{copy.company}</a></li>
				<li><a href={path('/nebosh/')}>NEBOSH</a></li>
				<li><a href={path('/training/')}>{copy.otherCourses}</a></li>
				<li><a href={path('/browse-hse-talent/')}>{copy.consulting}</a></li>
				<li><a href={path('/gallery/')}>{copy.gallery}</a></li>
				<li><a href={referencePath}>{copy.reference}</a></li>
				<li><a href={path('/contact/')}>{copy.contact}</a></li>
			</ul>
		</nav>

		<div class="site-footer__column site-footer__contact">
			<h2>{copy.getInTouch}</h2>
			<address>
				<p>{contactDetails.streetAddress}, {contactDetails.locality}</p>
				<a href={contactDetails.phoneHref}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7.1 1h-3a3 3 0 0 0-3 3.27 23 23 0 0 0 3.22 9.12 23 23 0 0 0 6.3 6.3 23 23 0 0 0 9.11 3.22 3 3 0 0 0 3.27-3v-3a3 3 0 0 0-2.31-2.92l-3.57-.84a3 3 0 0 0-2.84.79l-1.26 1.26a18 18 0 0 1-4.23-4.23l1.27-1.27a3 3 0 0 0 .78-2.83L10 3.31A3 3 0 0 0 7.1 1Z" /></svg><span>{contactDetails.phone}</span></a>
				<a href={contactDetails.emailHref}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 3a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H4a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h16Zm1 4.92-8.43 5.9a1 1 0 0 1-1.14 0L3 7.92V18a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V7.92ZM4 5a1 1 0 0 0-.89.55L12 11.78l8.89-6.23A1 1 0 0 0 20 5H4Z" /></svg><span>{contactDetails.email}</span></a>
			</address>
		</div>

		<div class="site-footer__column site-footer__newsletter">
			<h2>{copy.courseEnquiries}</h2>
			<p>{copy.enquiryDescription}</p>
			<a class="site-footer__enquiry" href={path('/contact/')}>{copy.contactUs} <span aria-hidden="true">→</span></a>
		</div>
	</div>

	<div class="site-footer__separator"><span></span></div>

	<div class="site-footer__bottom">
		<p>© {currentYear} <a href={path('/')}>{contactDetails.companyName}</a></p>
		<nav aria-label={copy.legalNavigation}>
			<ul>
				<li><a href="#">{copy.privacyPolicy}</a></li>
				<li><a href="#">{copy.terms}</a></li>
				<li><a href="#">{copy.copyright}</a></li>
			</ul>
		</nav>
	</div>
</footer>
