---
import type { Course } from '../../types/course';
import type { CommerceProduct } from '../../types/commerce';
import type { CoursesLandingPageContent } from '../../types/course-page';
import type { Locale } from '../../i18n/config';
import { getUiTranslations } from '../../i18n/ui';
import { getCourseUiTranslations } from '../../i18n/course-ui';
import { getContactFormPath } from '../../i18n/routes';
import { getCoursePublicPath } from '../../lib/course-routes';
import { formatCommercePrice } from '../../lib/cms';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CoursePlanCard from './CoursePlanCard.astro';

interface Props {
	courses: readonly Course[];
	trainingCourses: readonly Course[];
	locale: Locale;
	content: CoursesLandingPageContent;
	commerceProducts?: readonly CommerceProduct[];
}

const { courses, trainingCourses, locale, content, commerceProducts = [] } = Astro.props;
const pricingCopy = getUiTranslations(locale).homepage.pricing;
const courseCopy = getCourseUiTranslations(locale);
---

<main id="main-content">
	<Section spacing="compact">
		<Container>
			<SectionHeading level="h1" eyebrow={content.hero.eyebrow} align="center">
				{content.hero.title}
				<p slot="description">{content.hero.intro}</p>
			</SectionHeading>
		</Container>
	</Section>

	<Section tone="muted">
		<Container>
			<section class="course-group" aria-labelledby="nebosh-courses-title">
				<header class="course-group__heading">
					<p>{content.groups.nebosh.eyebrow}</p>
					<h2 id="nebosh-courses-title">{content.groups.nebosh.title}</h2>
				</header>
				<ul class="course-grid" aria-label={content.groups.nebosh.listLabel}>
					{courses.map((course) => {
						const purchasableProduct = commerceProducts.find((product) => (
							product.courseKey === course.courseKey && product.purchasable
						)) ?? null;
						return (
							<li>
								<CoursePlanCard
									title={course.title}
									label={course.homepageLabel}
									price={purchasableProduct ? formatCommercePrice(purchasableProduct, locale) : (course.visiblePrice ?? pricingCopy.priceOnRequest)}
									feeAvailability={pricingCopy.feeAvailability}
									summary={course.shortDescription}
									href={purchasableProduct?.checkoutUrl ?? getContactFormPath(locale)}
									ctaLabel={purchasableProduct ? courseCopy.card.buyNow : courseCopy.card.contactUs}
								/>
							</li>
						);
					})}
				</ul>
			</section>

			<section class="course-group course-group--training" aria-labelledby="training-courses-title">
				<header class="course-group__heading">
					<p>{content.groups.training.eyebrow}</p>
					<h2 id="training-courses-title">{content.groups.training.title}</h2>
				</header>
				<ul class="course-grid" aria-label={content.groups.training.listLabel}>
					{trainingCourses.map((course) => (
						<li>
							<CoursePlanCard
								title={course.title}
								label={course.homepageLabel}
								price={course.visiblePrice ?? pricingCopy.priceOnRequest}
								feeAvailability={pricingCopy.feeAvailability}
								summary={course.shortDescription}
								href={getCoursePublicPath(course, locale)}
								ctaLabel={course.homepageCtaLabel}
							/>
						</li>
					))}
				</ul>
			</section>
		</Container>
	</Section>
</main>

<style>
	.course-group--training {
		margin-top: clamp(5rem, 9vw, 8rem);
		padding-top: clamp(4rem, 7vw, 6rem);
		border-top: 1px solid var(--color-border);
	}

	.course-group__heading {
		margin-bottom: clamp(2.5rem, 5vw, 4.25rem);
		text-align: center;
	}

	.course-group__heading p {
		max-width: none;
		margin: 0 0 0.75rem;
		color: #dd6531;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.045em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.course-group__heading h2 {
		margin: 0;
		color: #292d36;
		font-size: clamp(2.3rem, 4vw, 3.6rem);
		font-weight: 600;
		letter-spacing: -0.05em;
		line-height: 1.03;
	}

	.course-grid {
		display: grid;
		grid-template-columns: minmax(0, 28.75rem);
		gap: 1.875rem;
		justify-content: center;
		max-width: 74.375rem;
		padding: 0;
		margin: 0 auto;
		list-style: none;
	}

	.course-grid > li {
		max-width: none;
	}

	@media (min-width: 48rem) {
		.course-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.course-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
