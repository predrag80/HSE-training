---
import Button from '../ui/Button.astro';
import type { Course } from '../../types/course';
import { getCoursePublicPath } from '../../lib/course-routes';

interface Props {
	course: Course;
}

const { course } = Astro.props;
const coursePath = getCoursePublicPath(course);
---

<article class="course-card surface-card">
	{
		course.featuredImageUrl && (
			<img
				class="course-card__image"
				src={course.featuredImageUrl}
				alt={`Course image for ${course.title}`}
				width="800"
				height="450"
				loading="lazy"
				decoding="async"
			/>
		)
	}
	<div class="course-card__body">
		<p class="course-card__eyebrow eyebrow">HSE course</p>
		<h2 class="course-card__title">{course.title}</h2>
		<p class="course-card__summary">{course.shortDescription}</p>
		{course.visiblePrice && <p class="course-card__price">{course.visiblePrice}</p>}
		<Button class="course-card__action" href={coursePath}>View course</Button>
	</div>
</article>

<style>
	.course-card {
		display: grid;
		height: 100%;
		overflow: hidden;
		border: 0;
		transition:
			box-shadow var(--transition-base),
			transform var(--transition-base);
	}

	.course-card:hover,
	.course-card:focus-within {
		box-shadow: var(--shadow-card-hover);
		transform: translateY(-0.25rem);
	}

	.course-card__image {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform var(--transition-media);
	}

	.course-card:hover .course-card__image,
	.course-card:focus-within .course-card__image {
		transform: scale(1.03);
	}

	.course-card__body {
		display: grid;
		grid-template-rows: auto auto 1fr auto auto;
		align-content: start;
		gap: var(--space-4);
		min-height: 28rem;
		padding: clamp(var(--space-6), 4vw, var(--space-8));
	}

	.course-card__body > * {
		margin: 0;
	}

	.course-card__title {
		font-size: var(--font-size-h3);
		line-height: var(--line-height-heading);
	}

	.course-card__eyebrow {
		margin-bottom: calc(var(--space-2) * -1);
	}

	.course-card__summary {
		color: var(--color-text-muted);
	}

	.course-card__price {
		padding-top: var(--space-4);
		color: var(--color-ink);
		font-size: var(--font-size-h2);
		font-weight: var(--font-weight-semibold);
		letter-spacing: -0.035em;
		line-height: var(--line-height-heading);
		border-top: 1px solid var(--color-border);
	}

	.course-card :global(.course-card__action) {
		width: 100%;
		margin-top: var(--space-2);
	}
</style>
