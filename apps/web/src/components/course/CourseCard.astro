---
import type { Course } from '../../types/course';

interface Props {
	course: Course;
}

const { course } = Astro.props;
---

<article class="course-card">
	{
		course.featuredImageUrl && (
			<img
				class="course-card__image"
				src={course.featuredImageUrl}
				alt={`Course image for ${course.title}`}
				width="800"
				height="450"
				loading="lazy"
				decoding="async"
			/>
		)
	}
	<div class="course-card__body">
		<h2 class="course-card__title">
			<a href={`/courses/${course.slug}`}>{course.title}</a>
		</h2>
		<p>{course.shortDescription}</p>
		{course.visiblePrice && <p class="course-card__price">{course.visiblePrice}</p>}
	</div>
</article>

<style>
	.course-card {
		display: grid;
		height: 100%;
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
	}

	.course-card__image {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.course-card__body {
		display: grid;
		align-content: start;
		gap: 0.75rem;
		padding: 1.25rem;
	}

	.course-card__body > * {
		margin: 0;
	}

	.course-card__title {
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.course-card__price {
		font-weight: 700;
	}
</style>
