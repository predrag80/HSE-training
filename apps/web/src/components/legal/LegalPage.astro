---
import './legal-page.css';
import type { LegalPageContent } from '../../types/legal';

type Props = Pick<LegalPageContent, 'title' | 'eyebrow' | 'intro' | 'lastUpdated' | 'sections'>;

const { title, eyebrow, intro, lastUpdated, sections } = Astro.props;
---

<section class="legal-page" aria-labelledby="legal-page-title">
	<div class="legal-page__hero">
		<div class="legal-page__container">
			<p class="legal-page__eyebrow">{eyebrow}</p>
			<h1 id="legal-page-title">{title}</h1>
			<p class="legal-page__intro">{intro}</p>
			<p class="legal-page__notice">{lastUpdated}</p>
		</div>
	</div>

	<div class="legal-page__container legal-page__content">
		{sections.map((section, index) => (
			<section>
				<div class="legal-page__heading">
					<span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
					<h2>{section.title}</h2>
				</div>
				<div class="legal-page__body"><Fragment set:html={section.bodyHtml} /></div>
			</section>
		))}
	</div>
</section>
