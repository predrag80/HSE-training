---
import './legal-page.css';

interface Props {
	readonly title: string;
	readonly placeholderLabel: string;
	readonly lastUpdated: string;
	readonly sections: readonly {
		readonly title: string;
		readonly paragraph: string;
	}[];
}

const { title, placeholderLabel, lastUpdated, sections } = Astro.props;
---

<section class="legal-page" aria-labelledby="legal-page-title">
	<div class="legal-page__hero">
		<div class="legal-page__container">
			<p class="legal-page__eyebrow">{placeholderLabel}</p>
			<h1 id="legal-page-title">{title}</h1>
			<p class="legal-page__notice">{lastUpdated}</p>
		</div>
	</div>

	<div class="legal-page__container legal-page__content">
		{sections.map((section) => (
			<section>
				<h2>{section.title}</h2>
				<p>{section.paragraph}</p>
			</section>
		))}
	</div>
</section>
