---
import type { Service } from '../../types/service';
import type { Locale } from '../../i18n/config';
import { getConsultingUiTranslations } from '../../i18n/consulting-ui';
import { getAvailablePublicPath, getLocalizedCmsHref } from '../../i18n/routes';
import './consulting-page.css';

interface Props {
	readonly services: readonly Service[];
	readonly locale: Locale;
}

const { services, locale } = Astro.props;
const copy = getConsultingUiTranslations(locale);

const industryImages = [
	'/images/consulting-service-01.webp',
	'/images/consulting-service-02.webp',
	'/images/consulting-service-03.webp',
	'/images/consulting-service-04.webp',
];

---

<section class="consulting-hero" aria-labelledby="consulting-page-title" data-consulting-parallax>
	<div class="consulting-hero__overlay" aria-hidden="true"></div>
	<div class="consulting-hero__content" data-consulting-reveal="hero">
		<p>{copy.heroEyebrow}</p>
		<h1 id="consulting-page-title">{copy.heroTitle}</h1>
	</div>
	<a class="consulting-hero__scroll" href="#consulting-intro" aria-label={copy.heroScroll}><span></span></a>
</section>

<section class="consulting-intro" id="consulting-intro">
	<div class="consulting-container consulting-intro__inner">
		<div class="consulting-intro__heading" data-consulting-reveal="left">
			<p class="consulting-kicker">{copy.introKicker}</p>
			<h2>{copy.introTitle}</h2>
		</div>
		<div class="consulting-intro__copy" data-consulting-reveal="right">
			{copy.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
			<a class="consulting-text-link" href={getAvailablePublicPath('/contact/', locale)}>{copy.introCta} <span aria-hidden="true">→</span></a>
			<a class="consulting-text-link consulting-text-link--directory" href="https://hsedirectory.com.au" target="_blank" rel="noreferrer">{copy.directoryCta} <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</section>

<section class="consulting-facts" aria-label={copy.capabilitiesLabel}>
	{copy.facts.map((fact) => <div class="consulting-facts__item" data-consulting-reveal="up"><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
</section>

<section class="consulting-services" aria-labelledby="consulting-services-title">
	<div class="consulting-container">
		<header class="consulting-section-heading" data-consulting-reveal="up">
			<p>{copy.servicesEyebrow}</p>
			<h2 id="consulting-services-title">{copy.servicesTitle}</h2>
		</header>
		<div class="consulting-services__grid">
			{services.map((service, index) => (
				<article class="consulting-service-card" data-consulting-reveal="up">
					<span>{String(index + 1).padStart(2, '0')}</span>
					<h3>{service.title}</h3>
					<p>{service.detailedDescription}</p>
					<a href={getLocalizedCmsHref(service.cta.url, locale)} aria-label={`${service.cta.label}: ${service.title}`}>{service.cta.label} <i aria-hidden="true">→</i></a>
				</article>
			))}
		</div>
	</div>
</section>

<section class="consulting-people" aria-labelledby="consulting-people-title">
	<div class="consulting-people__visual" data-consulting-reveal="left">
		<img src="/images/consulting-about-01.webp" width="950" height="800" alt={copy.peopleImageAlt} loading="lazy" decoding="async" />
	</div>
	<div class="consulting-people__content" data-consulting-reveal="right">
		<p class="consulting-kicker">{copy.peopleKicker}</p>
		<h2 id="consulting-people-title">{copy.peopleTitle}</h2>
		<p>{copy.peopleText}</p>
		<ul>
			{copy.peoplePoints.map((point) => <li><span aria-hidden="true">✓</span> {point}</li>)}
		</ul>
	</div>
</section>

<section class="consulting-industries" aria-labelledby="consulting-industries-title">
	<div class="consulting-container">
		<header class="consulting-section-heading consulting-section-heading--split" data-consulting-reveal="up">
			<div><p>{copy.industriesEyebrow}</p><h2 id="consulting-industries-title">{copy.industriesTitle}</h2></div>
			<span>{copy.industriesIntro}</span>
		</header>
		<div class="consulting-industries__grid">
			{copy.industries.map((industry, index) => (
				<article class="consulting-industry-card" data-consulting-reveal="up">
					<img src={industryImages[index]} width="600" height="815" alt="" loading="lazy" decoding="async" />
					<div class="consulting-industry-card__shade" aria-hidden="true"></div>
					<div class="consulting-industry-card__content"><h3>{industry.title}</h3><p>{industry.text}</p></div>
				</article>
			))}
		</div>
	</div>
</section>

<section class="consulting-experience" aria-labelledby="consulting-experience-title">
	<div class="consulting-container consulting-experience__inner">
		<div class="consulting-experience__copy" data-consulting-reveal="left">
			<p class="consulting-kicker">{copy.experienceKicker}</p>
			<h2 id="consulting-experience-title">{copy.experienceTitle}</h2>
			<p>{copy.experienceText}</p>
		</div>
		<ol class="consulting-experience__list" data-consulting-reveal="right">
			{copy.experienceAreas.map((area, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{area}</strong></li>)}
		</ol>
	</div>
</section>

<section class="consulting-languages" aria-labelledby="consulting-languages-title">
	<div class="consulting-container consulting-languages__inner">
		<div data-consulting-reveal="left">
			<p class="consulting-kicker">{copy.languagesKicker}</p>
			<h2 id="consulting-languages-title">{copy.languagesTitle}</h2>
		</div>
		<ul data-consulting-reveal="right">
			{copy.languages.map((language) => <li>{language}</li>)}
		</ul>
	</div>
</section>

<section class="consulting-qualifications" aria-labelledby="consulting-qualifications-title">
	<div class="consulting-qualifications__overlay" aria-hidden="true"></div>
	<div class="consulting-container consulting-qualifications__inner" data-consulting-reveal="up">
		<p>{copy.qualificationsEyebrow}</p>
		<h2 id="consulting-qualifications-title">{copy.qualificationsTitle}</h2>
		<ul aria-label={copy.qualificationsLabel}>
			{copy.qualifications.map((qualification) => <li>{qualification}</li>)}
		</ul>
	</div>
</section>

<section class="consulting-cta">
	<div class="consulting-container consulting-cta__inner" data-consulting-reveal="up">
		<div><p>{copy.ctaEyebrow}</p><h2>{copy.ctaTitle}</h2></div>
		<a href={getAvailablePublicPath('/contact/', locale)}>{copy.ctaLabel} <span aria-hidden="true">→</span></a>
	</div>
</section>

<script>
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const revealTargets = document.querySelectorAll<HTMLElement>('[data-consulting-reveal]');

	if (reducedMotion || !('IntersectionObserver' in window)) {
		revealTargets.forEach((target) => target.setAttribute('data-revealed', 'true'));
	} else {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.setAttribute('data-revealed', 'true');
				observer.unobserve(entry.target);
			});
		}, { threshold: 0.12, rootMargin: '0px 0px -7% 0px' });
		revealTargets.forEach((target) => observer.observe(target));
	}

	const hero = document.querySelector<HTMLElement>('[data-consulting-parallax]');
	let animationFrame = 0;
	const updateParallax = () => {
		animationFrame = 0;
		if (hero) hero.style.setProperty('--consulting-hero-shift', `${Math.min(scrollY * 0.45, 220)}px`);
	};
	const requestParallax = () => {
		if (animationFrame || reducedMotion) return;
		animationFrame = requestAnimationFrame(updateParallax);
	};
	addEventListener('scroll', requestParallax, { passive: true });
	updateParallax();
</script>
