---
import './contact-page.css';
import { contactDetails } from '../../lib/contact';
import type { Locale } from '../../i18n/config';
import { getContactUiTranslations } from '../../i18n/contact-ui';
import { getAvailablePublicPath } from '../../i18n/routes';
import { serverConfig } from '../../lib/config';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

interface Props {
	readonly locale: Locale;
}

const { locale } = Astro.props;
const copy = getContactUiTranslations(locale);
const privacyPolicyPath = getAvailablePublicPath('/privacy-policy/', locale);
const contactEndpoint = new URL('/wp-json/hse/v1/contact', serverConfig.wordpressApiUrl).toString();
const turnstileSiteKey = PUBLIC_TURNSTILE_SITE_KEY.trim();
const turnstileEnabled = turnstileSiteKey.length > 0;

interface ContactItem {
	readonly icon: string;
	readonly title: string;
	readonly lines: readonly { readonly text: string; readonly href?: string }[];
}

const contactItems: readonly ContactItem[] = [
	{
		icon: '\ue957',
		title: contactDetails.companyName,
		lines: [
			{ text: contactDetails.streetAddress },
			{ text: contactDetails.locality },
		],
	},
	{
		icon: '\ue99e',
		title: copy.callTitle,
		lines: [
			{ text: `${copy.phonePrefix}: ${contactDetails.phone}`, href: `https://wa.me/381615335010` },
			{ text: contactDetails.phone, href: contactDetails.phoneHref },
		],
	},
	{
		icon: '\uea82',
		title: copy.emailTitle,
		lines: [{ text: contactDetails.email, href: contactDetails.emailHref }],
	},
];
---

<section class="contact-hero" aria-labelledby="contact-page-title" data-contact-parallax>
	<div class="contact-hero__overlay" aria-hidden="true"></div>
	<div class="contact-hero__content">
		<p data-contact-reveal="hero-subtitle">{contactDetails.regionalCompanyName}</p>
		<h1 id="contact-page-title" data-contact-reveal="hero-title">{copy.title}</h1>
	</div>
	<a class="contact-hero__scroll" href="#contact-details" aria-label={copy.scroll} data-contact-reveal="hero-scroll">
		<span></span>
	</a>
</section>

<section class="contact-details" id="contact-details" aria-label={copy.detailsLabel}>
	<div class="contact-container contact-details__grid">
		{contactItems.map((item, index) => (
			<article class="contact-detail" data-contact-reveal="up" style={`--contact-delay:${index * 100}ms`}>
				<span class="contact-detail__icon" aria-hidden="true">{item.icon}</span>
				<h2>{item.title}</h2>
				<div class="contact-detail__content">
					{item.lines.map((line) => line.href ? <a href={line.href}>{line.text}</a> : <span>{line.text}</span>)}
				</div>
			</article>
		))}
	</div>
	<div class="contact-container contact-details__registration" data-contact-reveal="up">
		<span>{copy.vatLabel}: <strong>{contactDetails.vatNumber}</strong></span>
		<span>{copy.registrationLabel}: <strong>{contactDetails.registrationNumber}</strong></span>
		<span>{copy.activityLabel}: <strong>{contactDetails.activityCode} — {copy.activityDescription}</strong></span>
		<span>{copy.websiteLabel}: <strong><a href={contactDetails.websiteHref}>{contactDetails.website}</a></strong></span>
	</div>
</section>

<section class="contact-map" aria-label={copy.mapLabel} data-contact-reveal="map">
	<div class="contact-map__consent" data-map-consent>
		<strong>{copy.mapConsentTitle}</strong>
		<p>{copy.mapConsentDescription}</p>
		<button type="button" data-map-allow>{copy.mapConsentButton}</button>
	</div>
	<iframe
		title={copy.mapTitle}
		data-map-frame
		data-src={contactDetails.mapsEmbedUrl}
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"
		hidden
	></iframe>
	<div class="contact-map__card">
		<strong>{contactDetails.companyName}</strong>
		<p>{contactDetails.streetAddress},<br />{contactDetails.locality}</p>
		<a href={contactDetails.mapsExternalUrl} target="_blank" rel="noreferrer">{copy.mapLink}</a>
	</div>
</section>

<section class="contact-form-section" id="contact-form" aria-labelledby="contact-form-title">
	<div class="contact-container contact-form-section__inner">
		<header class="contact-form-section__header" data-contact-reveal="up">
			<p>{copy.formEyebrow}</p>
			<h2 id="contact-form-title">{copy.formTitle}</h2>
		</header>

		<form
			class="contact-form"
			method="post"
			data-contact-form
			data-contact-endpoint={contactEndpoint}
			data-success-message={copy.form.success}
			data-error-message={copy.form.error}
			data-rate-limit-message={copy.form.rateLimited}
			data-sending-message={copy.form.sending}
			data-turnstile-enabled={turnstileEnabled ? 'true' : 'false'}
			data-turnstile-site-key={turnstileSiteKey}
			data-turnstile-action="contact"
			data-verification-required-message={copy.form.verificationRequired}
			data-verification-expired-message={copy.form.verificationExpired}
			data-verification-failed-message={copy.form.verificationFailed}
			data-verification-unavailable-message={copy.form.verificationUnavailable}
			data-contact-reveal="form"
		>
			<input type="hidden" name="locale" value={locale} />
			<input type="hidden" name="turnstile_token" value="" />
			<label class="contact-form__trap" aria-hidden="true">
				<span>Company website</span>
				<input type="text" name="company_website" autocomplete="off" tabindex="-1" />
			</label>
			<div class="contact-form__fields">
				<label><span>{copy.form.nameLabel}</span><input type="text" name="name" placeholder={copy.form.namePlaceholder} autocomplete="name" required /></label>
				<label><span>{copy.form.emailLabel}</span><input type="email" name="email" placeholder={copy.form.emailPlaceholder} autocomplete="email" required /></label>
				<label class="contact-form__phone"><span>{copy.form.phoneLabel}</span><input type="tel" name="phone" placeholder={copy.form.phonePlaceholder} autocomplete="tel" /></label>
				<label class="contact-form__message"><span>{copy.form.messageLabel}</span><textarea name="message" rows="4" placeholder={copy.form.messagePlaceholder} minlength="10" maxlength="5000" required></textarea></label>
			</div>
			{turnstileEnabled && (
				<div class="contact-form__verification">
					<div data-turnstile-widget role="group" aria-label={copy.form.verificationLabel}></div>
				</div>
			)}
			<div class="contact-form__footer">
				<p>{copy.form.privacyPrefix} <a href={privacyPolicyPath}>{copy.form.privacyLink}</a>{copy.form.privacySuffix}</p>
				<button type="submit" disabled={turnstileEnabled}>{copy.form.submit}</button>
			</div>
			<p class="contact-form__status" role="status" aria-live="polite" data-contact-form-status></p>
		</form>
	</div>
</section>

<script>
	import * as Sentry from '@sentry/astro';
	import { sendContactEnquiry, type ContactEnquiry } from '../../lib/contact-form';
	import { allowsExternalMedia } from '../../lib/cookie-consent';

	interface TurnstileApi {
		render: (container: HTMLElement, options: {
			sitekey: string;
			action: string;
			theme: 'light';
			size: 'flexible';
			appearance: 'always';
			callback: (token: string) => void;
			'expired-callback': () => void;
			'error-callback': () => void;
		}) => string;
		reset: (widgetId: string) => void;
	}

	declare global {
		interface Window {
			turnstile?: TurnstileApi;
		}
	}

	let turnstileLoader: Promise<TurnstileApi> | undefined;
	const loadTurnstileApi = (): Promise<TurnstileApi> => {
		if (window.turnstile) return Promise.resolve(window.turnstile);
		if (turnstileLoader) return turnstileLoader;

		turnstileLoader = new Promise((resolve, reject) => {
			let settled = false;
			let timeoutId = 0;
			const existing = document.querySelector<HTMLScriptElement>('script[data-hse-turnstile]');
			const cleanup = () => {
				window.clearTimeout(timeoutId);
				existing?.removeEventListener('load', handleLoad);
				existing?.removeEventListener('error', handleError);
			};
			const finishWithError = () => {
				if (settled) return;
				settled = true;
				cleanup();
				turnstileLoader = undefined;
				reject(new Error('Turnstile could not be loaded.'));
			};
			const handleLoad = () => {
				if (settled) return;
				if (!window.turnstile) {
					finishWithError();
					return;
				}
				settled = true;
				cleanup();
				resolve(window.turnstile);
			};
			const handleError = () => finishWithError();

			if (existing) {
				existing.addEventListener('load', handleLoad, { once: true });
				existing.addEventListener('error', handleError, { once: true });
			} else {
				const script = document.createElement('script');
				script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
				script.async = true;
				script.defer = true;
				script.dataset.hseTurnstile = 'true';
				script.addEventListener('load', handleLoad, { once: true });
				script.addEventListener('error', handleError, { once: true });
				document.head.append(script);
			}

			timeoutId = window.setTimeout(finishWithError, 10_000);
		});

		return turnstileLoader;
	};

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('[data-contact-reveal]').forEach((element) => {
		if (reducedMotion || !('IntersectionObserver' in window)) {
			element.dataset.revealed = 'true';
			return;
		}
		const observer = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return;
			element.dataset.revealed = 'true';
			observer.disconnect();
		}, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
		observer.observe(element);
	});

	const hero = document.querySelector<HTMLElement>('[data-contact-parallax]');
	let frame = 0;
	const updateParallax = () => {
		frame = 0;
		if (hero) hero.style.setProperty('--contact-hero-shift', `${Math.min(scrollY * 0.5, 220)}px`);
	};
	const requestParallax = () => {
		if (frame || reducedMotion) return;
		frame = requestAnimationFrame(updateParallax);
	};
	addEventListener('scroll', requestParallax, { passive: true });
	updateParallax();

	const mapFrame = document.querySelector<HTMLIFrameElement>('[data-map-frame]');
	const mapConsent = document.querySelector<HTMLElement>('[data-map-consent]');
	const loadMap = () => {
		if (!mapFrame || !mapFrame.dataset.src) return;
		if (!mapFrame.src) mapFrame.src = mapFrame.dataset.src;
		mapFrame.hidden = false;
		if (mapConsent) mapConsent.hidden = true;
	};
	const unloadMap = () => {
		if (!mapFrame) return;
		mapFrame.removeAttribute('src');
		mapFrame.hidden = true;
		if (mapConsent) mapConsent.hidden = false;
	};
	if (allowsExternalMedia(document.cookie)) loadMap();
	document.querySelector<HTMLButtonElement>('[data-map-allow]')?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('hse:consent-request', { detail: { level: 'external-media' } }));
		loadMap();
	});
	window.addEventListener('hse:consent-changed', ((event: CustomEvent<{ level?: string }>) => {
		if (event.detail?.level === 'external-media') loadMap();
		else unloadMap();
	}) as EventListener);

	document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
		const status = form.querySelector<HTMLElement>('[data-contact-form-status]');
		const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		const tokenInput = form.querySelector<HTMLInputElement>('input[name="turnstile_token"]');
		const widget = form.querySelector<HTMLElement>('[data-turnstile-widget]');
		const endpoint = form.dataset.contactEndpoint;
		const turnstileEnabled = form.dataset.turnstileEnabled === 'true';
		const sitekey = form.dataset.turnstileSiteKey ?? '';
		const action = form.dataset.turnstileAction ?? 'contact';
		let turnstileApi: TurnstileApi | undefined;
		let widgetId = '';
		let submitting = false;
		let turnstileErrorReported = false;

		if (!status || !submit || !tokenInput || !endpoint) return;

		const setVerificationError = (message: string) => {
			tokenInput.value = '';
			submit.disabled = true;
			status.dataset.state = 'verification';
			status.textContent = message;
		};
		const reportTurnstileUnavailable = () => {
			if (turnstileErrorReported) return;
			turnstileErrorReported = true;
			Sentry.withScope((scope) => {
				scope.setTag('component', 'contact-form');
				scope.setTag('submission_result', 'verification-unavailable');
				scope.setTag('locale', form.querySelector<HTMLInputElement>('input[name="locale"]')?.value === 'sr' ? 'sr' : 'en');
				scope.setFingerprint(['contact-form', 'turnstile-unavailable']);
				Sentry.captureMessage('Contact form security verification is unavailable.', 'error');
			});
		};
		const resetTurnstile = () => {
			tokenInput.value = '';
			if (!turnstileEnabled) {
				submit.disabled = false;
				return;
			}

			submit.disabled = true;
			if (!turnstileApi || !widgetId) return;
			try {
				turnstileApi.reset(widgetId);
			} catch {
				setVerificationError(form.dataset.verificationUnavailableMessage ?? '');
				reportTurnstileUnavailable();
			}
		};

		if (turnstileEnabled) {
			if (!sitekey || !widget) {
				setVerificationError(form.dataset.verificationUnavailableMessage ?? '');
				reportTurnstileUnavailable();
			} else {
				loadTurnstileApi()
					.then((api) => {
						turnstileApi = api;
						widgetId = api.render(widget, {
							sitekey,
							action,
							theme: 'light',
							size: 'flexible',
							appearance: 'always',
							callback: (token) => {
								turnstileErrorReported = false;
								tokenInput.value = token.trim();
								if (!submitting && tokenInput.value) submit.disabled = false;
								if (status.dataset.state === 'verification') {
									status.removeAttribute('data-state');
									status.textContent = '';
								}
							},
							'expired-callback': () => {
								setVerificationError(form.dataset.verificationExpiredMessage ?? '');
							},
							'error-callback': () => {
								setVerificationError(form.dataset.verificationUnavailableMessage ?? '');
								reportTurnstileUnavailable();
							},
						});
					})
					.catch(() => {
						setVerificationError(form.dataset.verificationUnavailableMessage ?? '');
						reportTurnstileUnavailable();
					});
			}
		} else {
			submit.disabled = false;
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			if (turnstileEnabled && !tokenInput.value) {
				setVerificationError(form.dataset.verificationRequiredMessage ?? '');
				return;
			}

			const fields = new FormData(form);
			const enquiry: ContactEnquiry = {
				name: String(fields.get('name') ?? ''),
				email: String(fields.get('email') ?? ''),
				phone: String(fields.get('phone') ?? ''),
				message: String(fields.get('message') ?? ''),
				locale: fields.get('locale') === 'sr' ? 'sr' : 'en',
				company_website: String(fields.get('company_website') ?? ''),
				turnstile_token: String(fields.get('turnstile_token') ?? ''),
			};

			submitting = true;
			submit.disabled = true;
			status.dataset.state = 'sending';
			status.textContent = form.dataset.sendingMessage ?? '';
			const result = await Sentry.startSpan(
				{ name: 'contact-form.submit', op: 'http.client' },
				() => sendContactEnquiry(endpoint, enquiry),
			);

			if (result === 'success') {
				form.reset();
				status.dataset.state = 'success';
				status.textContent = form.dataset.successMessage ?? '';
			} else if (result === 'rate-limited') {
				Sentry.withScope((scope) => {
					scope.setTag('component', 'contact-form');
					scope.setTag('submission_result', result);
					scope.setTag('locale', enquiry.locale);
					scope.setFingerprint(['contact-form', result]);
					Sentry.captureMessage('Contact form submission was rate limited.', 'info');
				});
				status.dataset.state = 'error';
				status.textContent = form.dataset.rateLimitMessage ?? '';
			} else if (result === 'verification-failed') {
				status.dataset.state = 'error';
				status.textContent = form.dataset.verificationFailedMessage ?? '';
			} else if (result === 'verification-unavailable') {
				reportTurnstileUnavailable();
				status.dataset.state = 'error';
				status.textContent = form.dataset.verificationUnavailableMessage ?? '';
			} else {
				Sentry.withScope((scope) => {
					scope.setTag('component', 'contact-form');
					scope.setTag('submission_result', result);
					scope.setTag('locale', enquiry.locale);
					scope.setFingerprint(['contact-form', result]);
					Sentry.captureMessage('Contact form submission failed.', 'error');
				});
				status.dataset.state = 'error';
				status.textContent = form.dataset.errorMessage ?? '';
			}

			submitting = false;
			resetTurnstile();
		});
	});
</script>
