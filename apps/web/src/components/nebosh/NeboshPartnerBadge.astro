---
import type { Locale } from '../../i18n/config';

interface Props {
	readonly locale: Locale;
	readonly variant?: 'band' | 'compact';
}

const { locale, variant = 'band' } = Astro.props;
const copy = locale === 'sr'
	? {
		eyebrow: 'Akreditovani partner za obuku',
		title: 'NEBOSH Silver Learning Partner 1352',
		text: 'HSE Training je zvanično priznati NEBOSH Silver Learning Partner broj 1352.',
		alt: 'NEBOSH Silver Learning Partner 1352',
	}
	: {
		eyebrow: 'Accredited learning partner',
		title: 'NEBOSH Silver Learning Partner 1352',
		text: 'HSE Training is officially recognised as NEBOSH Silver Learning Partner number 1352.',
		alt: 'NEBOSH Silver Learning Partner 1352',
	};
---

<aside class:list={['nebosh-partner', `nebosh-partner--${variant}`]} aria-label={copy.title} data-nebosh-reveal="up">
	<div class="nebosh-partner__inner">
		<img src="/images/nebosh-learning-partner-1352.png" width="2331" height="992" alt={copy.alt} loading="lazy" decoding="async" />
		<div class="nebosh-partner__copy">
			<span>{copy.eyebrow}</span>
			<strong>{copy.title}</strong>
			<p>{copy.text}</p>
		</div>
	</div>
</aside>

<style>
	.nebosh-partner {
		color: #fff;
		background: #153f72;
	}

	.nebosh-partner__inner {
		display: grid;
		width: min(76.25rem, calc(100% - 3.75rem));
		grid-template-columns: minmax(15rem, 21rem) 1fr;
		gap: clamp(2rem, 6vw, 6rem);
		align-items: center;
		margin-inline: auto;
	}

	.nebosh-partner img {
		display: block;
		width: 100%;
		height: auto;
		background: #fff;
	}

	.nebosh-partner__copy {
		display: grid;
		gap: 0.55rem;
	}

	.nebosh-partner__copy span {
		color: #f49a76;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.nebosh-partner__copy strong {
		color: #fff;
		font-size: clamp(1.55rem, 3vw, 2.45rem);
		font-weight: 600;
		letter-spacing: -0.045em;
		line-height: 1.08;
	}

	.nebosh-partner__copy p {
		max-width: 42rem;
		margin: 0;
		color: rgb(255 255 255 / 70%);
		line-height: 1.7;
	}

	.nebosh-partner--band {
		padding: clamp(3.25rem, 6vw, 5.25rem) 0;
	}

	.nebosh-partner--compact {
		margin-top: 2.25rem;
		padding: 1.25rem;
		color: #292d36;
		background: #f5f5f3;
		border-left: 0.1875rem solid #dd6531;
	}

	.nebosh-partner--compact .nebosh-partner__inner {
		width: 100%;
		grid-template-columns: 9rem 1fr;
		gap: 1.25rem;
	}

	.nebosh-partner--compact .nebosh-partner__copy span {
		color: #dd6531;
	}

	.nebosh-partner--compact .nebosh-partner__copy strong {
		color: #292d36;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}

	.nebosh-partner--compact .nebosh-partner__copy p {
		color: #737582;
		font-size: 0.84rem;
		line-height: 1.55;
	}

	@media (max-width: 47.999rem) {
		.nebosh-partner__inner,
		.nebosh-partner--compact .nebosh-partner__inner {
			width: calc(100% - 1.875rem);
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.nebosh-partner img {
			max-width: 23rem;
		}

		.nebosh-partner--compact {
			padding: 1rem;
		}

		.nebosh-partner--compact .nebosh-partner__inner {
			width: 100%;
		}
	}
</style>
