---
import './nebosh-pages.css';
import type { Course } from '../../types/course';
import type { Locale } from '../../i18n/config';
import { getAvailablePublicPath } from '../../i18n/routes';
import { getCourseUiTranslations } from '../../i18n/course-ui';
import NeboshHero from './NeboshHero.astro';
import NeboshMotion from './NeboshMotion.astro';

interface Props {
	course?: Course | null;
	locale: Locale;
}

const { course = null, locale } = Astro.props;
const copy = getCourseUiTranslations(locale).nebosh;
const iogc = copy.iogc;
const courseTitle = course?.title ?? iogc.fallbackTitle;
const heroImage = course?.featuredImageUrl ?? '/images/nebosh-iogc-hero.jpg';
---

<NeboshHero eyebrow={iogc.eyebrow} title={courseTitle} image={heroImage} titleId="iogc-title" scrollLabel={copy.heroScroll} compact />

<section class="iogc-status" id="course-content">
	<div class="nebosh-container iogc-status__inner">
		<div data-nebosh-reveal="left">
			<p class="nebosh-kicker">{iogc.statusKicker}</p>
			<h2>{iogc.statusTitle}</h2>
		</div>
		<div data-nebosh-reveal="right">
			{iogc.statusParagraphs.map((paragraph) => <p>{paragraph}</p>)}
			<p>{iogc.deadlinePrefix} <strong>{iogc.deadline}</strong>. {iogc.deadlineSuffix}</p>
			<div class="iogc-status__links">
				<a class="nebosh-text-link" href={getAvailablePublicPath('/contact/', locale)}>{iogc.contactCta} <span aria-hidden="true">→</span></a>
				<a class="nebosh-text-link" href="https://www.nebosh.org.uk/qualifications/international-oil-and-gas-certificate/" target="_blank" rel="noreferrer">{iogc.officialCta} <span aria-hidden="true">↗</span></a>
			</div>
		</div>
	</div>
</section>

{
	course?.descriptionHtml && (
		<section class="nebosh-cms-content nebosh-cms-content--muted" aria-labelledby="iogc-cms-content-title">
			<div class="nebosh-container nebosh-cms-content__inner" data-nebosh-reveal="up">
				<p class="nebosh-kicker">{iogc.cmsKicker}</p>
				<h2 id="iogc-cms-content-title">{iogc.cmsTitle}</h2>
				{/* This HTML is trusted editor-authored content validated at the CMS boundary. */}
				<div class="nebosh-cms-content__body">
					<Fragment set:html={course.descriptionHtml} />
				</div>
			</div>
		</section>
	)
}

<section class="iogc-focus" aria-labelledby="iogc-focus-title">
	<div class="nebosh-container">
		<div class="iogc-focus__header" data-nebosh-reveal="up">
			<h2 id="iogc-focus-title">{iogc.focusTitle}</h2>
			<strong>{iogc.focusLabel}</strong>
		</div>
		<div class="iogc-focus__steps">
			{iogc.focusAreas.map((area, index) => (
				<article data-nebosh-reveal="up"><span>0{index + 1}</span><h3>{area.title}</h3><p>{area.text}</p></article>
			))}
		</div>
	</div>
</section>

<section class="iogc-band">
	<div class="iogc-band__overlay" aria-hidden="true"></div>
	<div class="iogc-band__content" data-nebosh-reveal="up">
		<span aria-hidden="true">✓</span>
		<p>{iogc.bandLabel}</p>
		<h2>{iogc.bandTitle}</h2>
	</div>
</section>

<section class="iogc-audience" aria-labelledby="iogc-audience-title">
	<div class="nebosh-container">
		<header class="nebosh-section-heading" data-nebosh-reveal="up"><p>{iogc.audienceKicker}</p><h2 id="iogc-audience-title">{iogc.audienceTitle}</h2></header>
		<div class="iogc-audience__grid">
			{iogc.audiences.map((audience, index) => <article data-nebosh-reveal="up"><span>0{index + 1}</span><h3>{audience.title}</h3><p>{audience.text}</p></article>)}
		</div>
		<p class="nebosh-inline-cta">{iogc.inlineCta} <a href={getAvailablePublicPath('/contact/', locale)}>{iogc.inlineLink}</a></p>
	</div>
</section>

<NeboshMotion />
