---
import './nebosh-pages.css';
import type { Course } from '../../types/course';
import type { NeboshOverviewPageContent } from '../../types/course-page';
import type { Locale } from '../../i18n/config';
import { getAvailablePublicPath } from '../../i18n/routes';
import { getCourseUiTranslations } from '../../i18n/course-ui';
import { getCoursePublicPath } from '../../lib/course-routes';
import NeboshHero from './NeboshHero.astro';
import NeboshMotion from './NeboshMotion.astro';

interface Props {
	igcCourse?: Course | null;
	iogcCourse?: Course | null;
	locale: Locale;
	content: NeboshOverviewPageContent;
}

const { igcCourse = null, iogcCourse = null, locale, content } = Astro.props;
const copy = getCourseUiTranslations(locale).nebosh;
const { hero, strengths, intro, courseSelection, testimonial } = content;
---

<NeboshHero eyebrow={hero.eyebrow} title={hero.title} image="/images/nebosh-overview-hero.jpg" titleId="nebosh-title" scrollLabel={copy.heroScroll} />

<section class="nebosh-overview-strip" aria-label={copy.benefitsLabel}>
	{strengths.map((item, index) => (
		<article data-nebosh-reveal="up">
			<span>0{index + 1}</span>
			<h2>{item.title}</h2>
			<p>{item.text}</p>
		</article>
	))}
</section>

<section class="nebosh-overview-intro" id="course-content">
	<div class="nebosh-container nebosh-overview-intro__inner">
		<div class="nebosh-overview-intro__copy" data-nebosh-reveal="left">
			<p class="nebosh-kicker">{intro.kicker}</p>
			<h2>{intro.title}</h2>
			{intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			<a class="nebosh-button" href={getAvailablePublicPath('/contact/', locale)}>{intro.ctaLabel}</a>
		</div>
		<div class="nebosh-overview-intro__visual" data-nebosh-reveal="right">
			<img src="/images/nebosh-overview-feature.webp" width="570" height="561" alt={intro.imageAlt} />
			<div><strong>{intro.visualTitle}</strong><span>{intro.visualText}</span></div>
		</div>
	</div>
</section>

<section class="nebosh-courses" aria-labelledby="nebosh-courses-title">
	<div class="nebosh-container">
		<header class="nebosh-section-heading" data-nebosh-reveal="up">
			<p>{courseSelection.kicker}</p>
			<h2 id="nebosh-courses-title">{courseSelection.title}</h2>
		</header>
		<div class="nebosh-courses__grid">
			<a class="nebosh-course-card nebosh-course-card--igc" href={igcCourse ? getCoursePublicPath(igcCourse, locale) : getAvailablePublicPath('/nebosh-international-general-certificate-in-occupational-health-and-safety/', locale)} data-nebosh-reveal="up">
				{igcCourse?.featuredImageUrl && <img class="nebosh-course-card__image" src={igcCourse.featuredImageUrl} alt="" loading="lazy" decoding="async" />}
				<div class="nebosh-course-card__shade"></div>
				<div class="nebosh-course-card__content">
					<span>{courseSelection.currentLabel}</span>
					<h3>{igcCourse?.title ?? 'NEBOSH International General Certificate'}</h3>
					<p>{igcCourse?.shortDescription ?? courseSelection.igcFallback}</p>
					<strong>{courseSelection.igcCtaLabel} <i aria-hidden="true">→</i></strong>
				</div>
			</a>
			<a class="nebosh-course-card nebosh-course-card--iogc" href={iogcCourse ? getCoursePublicPath(iogcCourse, locale) : getAvailablePublicPath('/nebosh-international-oilgas-certificate/', locale)} data-nebosh-reveal="up">
				{iogcCourse?.featuredImageUrl && <img class="nebosh-course-card__image" src={iogcCourse.featuredImageUrl} alt="" loading="lazy" decoding="async" />}
				<div class="nebosh-course-card__shade"></div>
				<div class="nebosh-course-card__content">
					<span>{courseSelection.legacyLabel}</span>
					<h3>{iogcCourse?.title ?? 'NEBOSH International Oil & Gas Certificate'}</h3>
					<p>{iogcCourse?.shortDescription ?? courseSelection.iogcFallback}</p>
					<strong>{courseSelection.iogcCtaLabel} <i aria-hidden="true">→</i></strong>
				</div>
			</a>
		</div>
	</div>
</section>

<section class="nebosh-quote">
	<div class="nebosh-container nebosh-quote__inner" data-nebosh-reveal="up">
		<span aria-hidden="true">“</span>
		<blockquote>
			<p>{testimonial.quote}</p>
			<footer><strong>{testimonial.author}</strong><small>{testimonial.role}</small></footer>
		</blockquote>
	</div>
</section>

<NeboshMotion />
