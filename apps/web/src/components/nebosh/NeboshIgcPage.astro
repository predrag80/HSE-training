---
import './nebosh-pages.css';
import type { Course } from '../../types/course';
import type { Locale } from '../../i18n/config';
import { getAvailablePublicPath } from '../../i18n/routes';
import { getCourseUiTranslations } from '../../i18n/course-ui';
import { contactDetails } from '../../lib/contact';
import NeboshHero from './NeboshHero.astro';
import NeboshMotion from './NeboshMotion.astro';

interface Props {
	course?: Course | null;
	locale: Locale;
}

const { course = null, locale } = Astro.props;
const copy = getCourseUiTranslations(locale).nebosh;
const igc = copy.igc;
const courseTitle = course?.title ?? igc.fallbackTitle;
const courseSummary =
	course?.shortDescription ??
	igc.fallbackSummary;
const heroImage = course?.featuredImageUrl ?? '/images/nebosh-igc-hero.jpg';
---

<NeboshHero eyebrow={igc.eyebrow} title={courseTitle} image={heroImage} titleId="igc-title" scrollLabel={copy.heroScroll} compact />

<section class="nebosh-detail-intro" id="course-content">
	<div class="nebosh-container nebosh-detail-intro__inner">
		<div class="nebosh-detail-intro__image" data-nebosh-reveal="left">
			<img src="/images/nebosh-igc-feature.webp" width="600" height="590" alt={igc.imageAlt} />
		</div>
		<div class="nebosh-detail-intro__copy" data-nebosh-reveal="right">
			<p class="nebosh-kicker">{igc.introKicker}</p>
			<h2>{igc.introTitle}</h2>
			<p>{courseSummary}</p>
			{course?.visiblePrice && <p class="nebosh-course-price"><span>{igc.priceLabel}</span><strong>{course.visiblePrice}</strong></p>}
			<ul class="nebosh-icon-list">
				{igc.highlights.map((highlight) => <li><span aria-hidden="true">✓</span><div><strong>{highlight.title}</strong><small>{highlight.text}</small></div></li>)}
			</ul>
		</div>
	</div>
</section>

{
	course?.descriptionHtml && (
		<section class="nebosh-cms-content" aria-labelledby="igc-cms-content-title">
			<div class="nebosh-container nebosh-cms-content__inner" data-nebosh-reveal="up">
				<p class="nebosh-kicker">{igc.cmsKicker}</p>
				<h2 id="igc-cms-content-title">{igc.cmsTitle}</h2>
				{/* This HTML is trusted editor-authored content validated at the CMS boundary. */}
				<div class="nebosh-cms-content__body">
					<Fragment set:html={course.descriptionHtml} />
				</div>
			</div>
		</section>
	)
}

<section class="nebosh-outcomes" aria-labelledby="igc-outcomes-title">
	<div class="nebosh-container nebosh-outcomes__inner">
		<header data-nebosh-reveal="left">
			<p class="nebosh-kicker">{igc.outcomesKicker}</p>
			<h2 id="igc-outcomes-title">{igc.outcomesTitle}</h2>
			<p>{igc.outcomesIntro}</p>
			<a class="nebosh-button" href={getAvailablePublicPath('/contact/', locale)}>{igc.askCta}</a>
		</header>
		<div class="nebosh-outcomes__grid">
			{igc.outcomes.map((outcome, index) => (
				<article data-nebosh-reveal="up">
					<span>0{index + 1}</span><h3>{outcome.title}</h3><p>{outcome.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<section class="nebosh-assessment">
	<div class="nebosh-assessment__visual" role="img" aria-label={igc.assessmentImageAlt} data-nebosh-reveal="left"></div>
	<div class="nebosh-assessment__copy" data-nebosh-reveal="right">
		<p class="nebosh-kicker">{igc.assessmentKicker}</p>
		<h2>{igc.assessmentTitle}</h2>
		<p>{igc.assessmentIntro}</p>
		<ul>
			<li><span>GIC1</span> {igc.gic1}</li>
			<li><span>GIC2</span> {igc.gic2}</li>
		</ul>
	</div>
</section>

<section class="nebosh-faq" aria-labelledby="igc-faq-title">
	<div class="nebosh-container nebosh-faq__inner">
		<header data-nebosh-reveal="left"><p class="nebosh-kicker">{igc.faqKicker}</p><h2 id="igc-faq-title">{igc.faqTitle}</h2></header>
		<div class="nebosh-faq__items" data-nebosh-reveal="right">
			{igc.faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
		</div>
	</div>
	<p class="nebosh-inline-cta">{igc.inlineCta} <a href={contactDetails.emailHref}>{contactDetails.email}</a></p>
</section>

<NeboshMotion />
