---
import './company-page.css';
import type { CompanyPageContent } from '../../types/company';
import { getCompanyUiTranslations } from '../../i18n/company-ui';
import { getAvailablePublicPath, getLocalizedCmsHref } from '../../i18n/routes';
import HomeExperts from '../home/HomeExperts.astro';
import NeboshPartnerBadge from '../nebosh/NeboshPartnerBadge.astro';
import ClientMarquee from '../shared/ClientMarquee.astro';
import { clients } from '../../data/clients';

interface Props {
	content: CompanyPageContent;
}

const { content } = Astro.props;
const copy = getCompanyUiTranslations(content.locale);

const reasonIcons = [
	{ icon: 'like', glyph: '\uea44' },
	{ icon: 'analytics', glyph: '\uea0b' },
	{ icon: 'leadership', glyph: '\uea93' },
	{ icon: 'production', glyph: '\ue68d' },
];

---

<section class="company-hero" aria-labelledby="company-page-title" data-company-parallax>
	<div class="company-hero__overlay"></div>
	<div class="company-hero__content" data-company-reveal="flip">
		<p>{content.hero.eyebrow}</p>
		<h1 id="company-page-title">{content.hero.title}</h1>
	</div>
	<a class="company-hero__scroll" href="#about" aria-label={copy.scrollToAbout}>
		<span></span>
	</a>
</section>

<section class="company-intro" id="about">
	<div class="company-container company-intro__inner">
		<div class="company-intro__title" data-company-reveal="intro-title">
			<h2>{content.profile.headline}</h2>
		</div>
		<div class="company-intro__copy" data-company-reveal="children-intro-copy">
			<p>{content.profile.description}</p>
			<a href={getLocalizedCmsHref(content.introCta.url, content.locale)}>{content.introCta.label}</a>
		</div>
	</div>
</section>

<section class="company-timeline" aria-label={copy.milestonesLabel}>
	<div class="company-container company-timeline__inner">
		<div class="company-timeline__side" data-company-reveal="children-from-right">
			{copy.milestones.slice(0, 2).map((milestone) => (
				<article class="company-milestone">
					<strong data-company-counter={milestone.year}>{milestone.year}</strong>
					<div><h2>{milestone.title}</h2><p>{milestone.text}</p></div>
				</article>
			))}
		</div>
		<div class="company-timeline__image" data-company-reveal="timeline-image">
			<img src="/images/consulting-company-timeline.webp" width="485" height="485" alt={copy.timelineImageAlt} />
		</div>
		<div class="company-timeline__side" data-company-reveal="children-from-left">
			{copy.milestones.slice(2).map((milestone) => (
				<article class="company-milestone">
					<strong data-company-counter={milestone.year}>{milestone.year}</strong>
					<div><h2>{milestone.title}</h2><p>{milestone.text}</p></div>
				</article>
			))}
		</div>
	</div>
</section>

<NeboshPartnerBadge locale={content.locale} />

<section class="company-agency">
	<div class="company-agency__image" role="img" aria-label={copy.agencyImageAlt} data-company-reveal="agency-image"></div>
	<div class="company-agency__content" data-company-reveal="children-up-delayed">
		<h2>{copy.agencyTitle}</h2>
		<p>{copy.agencyText}</p>
		<ul>
			{copy.agencyPoints.map((point) => <li><span aria-hidden="true">✓</span>{point}</li>)}
		</ul>
	</div>
</section>

<section class="company-expertise" aria-labelledby="company-expertise-title">
	<div class="company-container">
		<header class="company-expertise__header" data-company-reveal="fade">
			<p>{copy.expertiseEyebrow}</p>
			<h2 id="company-expertise-title">{copy.expertiseTitle}</h2>
		</header>
		<div class="company-expertise__grid" data-company-reveal="children-up">
			{copy.expertise.map((item, index) => (
				<article class="company-skill">
					<span class="company-skill__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
					<h3>{item.title}</h3>
					{item.description.map((paragraph) => <p>{paragraph}</p>)}
				</article>
			))}
		</div>
	</div>
</section>

<section class="company-reasons" aria-labelledby="company-reasons-title">
	<div class="company-container company-reasons__inner">
		<div class="company-reasons__cards" data-company-reasons>
			<div class="company-reasons__column company-reasons__column--down">
				{copy.reasons.slice(0, 2).map((reason, index) => (
					<article class="company-reason-card">
						<div class="company-reason-card__content">
							<span class:list={['company-reason-card__icon', `company-reason-card__icon--${reasonIcons[index].icon}`]} aria-hidden="true">{reasonIcons[index].glyph}</span>
							<h3>{reason.title}</h3>
							<p>{reason.text}</p>
						</div>
					</article>
				))}
			</div>
			<div class="company-reasons__column company-reasons__column--up">
				{copy.reasons.slice(2).map((reason, index) => (
					<article class="company-reason-card">
						<div class="company-reason-card__content">
							<span class:list={['company-reason-card__icon', `company-reason-card__icon--${reasonIcons[index + 2].icon}`]} aria-hidden="true">{reasonIcons[index + 2].glyph}</span>
							<h3>{reason.title}</h3>
							<p>{reason.text}</p>
						</div>
					</article>
				))}
			</div>
		</div>

		<div class="company-reasons__copy" data-company-reveal="children-from-right">
			<h2 id="company-reasons-title">{copy.reasonsTitle}</h2>
			<p>{copy.reasonsText}</p>
			<a href={getAvailablePublicPath('/contact/', content.locale)}>{copy.reasonsCta}</a>
		</div>
	</div>
</section>

<HomeExperts experts={content.profile.team} locale={content.locale} headingId="company-team-title" />

<section class="company-logos" aria-labelledby="company-clients-title">
	<div class="company-container" data-company-reveal="fade">
		<header class="company-logos__header">
			<p>{copy.clientsEyebrow}</p>
			<h2 id="company-clients-title">{copy.clientsTitle}</h2>
		</header>
		<div data-company-reveal="children-from-right-slow">
			<ClientMarquee {clients} label={copy.trustedCompanies} />
		</div>
	</div>
</section>

<script>
	const sections = document.querySelectorAll<HTMLElement>('[data-company-reveal]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const reveal = (element: HTMLElement) => {
		element.dataset.revealed = 'true';
		element.querySelectorAll<HTMLElement>('[data-company-counter]').forEach((counter) => {
			const target = Number(counter.dataset.companyCounter ?? 0);
			if (reducedMotion) {
				counter.textContent = String(target);
				return;
			}
			const startedAt = performance.now();
			const tick = (now: number) => {
				const progress = Math.min((now - startedAt) / 900, 1);
				counter.textContent = String(Math.round(target * (1 - Math.pow(1 - progress, 3))));
				if (progress < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		});
	};

	if (reducedMotion || !('IntersectionObserver' in window)) {
		sections.forEach(reveal);
	} else {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
				reveal(entry.target);
				observer.unobserve(entry.target);
			});
		}, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
		sections.forEach((section) => observer.observe(section));
	}

	const hero = document.querySelector<HTMLElement>('[data-company-parallax]');
	const reasonCards = document.querySelector<HTMLElement>('[data-company-reasons]');
	if (reasonCards) {
		reasonCards.dataset.entryReady = 'true';
		if (reducedMotion || !('IntersectionObserver' in window)) {
			reasonCards.dataset.entryRevealed = 'true';
		} else {
			const cardObserver = new IntersectionObserver((entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				reasonCards.dataset.entryRevealed = 'true';
				cardObserver.disconnect();
			}, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
			cardObserver.observe(reasonCards);
		}
	}
	let ticking = false;
	const updateParallax = () => {
		if (hero) hero.style.setProperty('--company-hero-shift', `${Math.min(scrollY * 0.5, 220)}px`);
		if (reasonCards) {
			const rect = reasonCards.getBoundingClientRect();
			const centerDelta = rect.top + rect.height / 2 - innerHeight / 2;
			const shift = Math.max(-50, Math.min(50, centerDelta * 0.067 + 7));
			reasonCards.style.setProperty('--company-card-shift', `${shift}px`);
		}
		ticking = false;
	};
	const requestParallax = () => {
		if (ticking || reducedMotion) return;
		ticking = true;
		requestAnimationFrame(updateParallax);
	};
	addEventListener('scroll', requestParallax, { passive: true });
	updateParallax();
</script>
