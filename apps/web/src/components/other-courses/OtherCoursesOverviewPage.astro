---
import './other-courses.css';
import OtherCoursesHero from './OtherCoursesHero.astro';
import OtherCoursesGrid from './OtherCoursesGrid.astro';
import OtherCoursesMotion from './OtherCoursesMotion.astro';
import type { Locale } from '../../i18n/config';
import { getOtherCoursesUiTranslations } from '../../i18n/other-courses-ui';

interface Props { readonly locale: Locale; }
const { locale } = Astro.props;
const copy = getOtherCoursesUiTranslations(locale);
---

<OtherCoursesHero eyebrow={copy.overview.heroEyebrow} title={copy.overview.heroTitle} image="/images/consulting-hero-03.webp" titleId="other-courses-title" scrollLabel={copy.common.heroScroll} />

<section class="other-courses-selector" id="course-content" aria-labelledby="other-courses-selector-title">
	<div class="other-courses-container">
		<header class="other-courses-heading" data-other-courses-reveal="up">
			<p>{copy.overview.selectorEyebrow}</p>
			<h2 id="other-courses-selector-title">{copy.overview.selectorTitle}</h2>
		</header>
		<OtherCoursesGrid {locale} animated />
	</div>
</section>

<OtherCoursesMotion />
