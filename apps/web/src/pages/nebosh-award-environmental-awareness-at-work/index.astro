---
import EditorialCoursePage from '../../components/course/EditorialCoursePage.astro';
import NeboshPartnerBadge from '../../components/nebosh/NeboshPartnerBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEditorialCourseUi } from '../../i18n/editorial-course-ui';
import { NEBOSH_COURSE_KEYS } from '../../lib/course-routes';
import { loadRequiredNeboshCourse } from '../../lib/nebosh-course-content';
import { getOptionalCommerceProduct } from '../../lib/cms';

const locale = 'en';
const copy = getEditorialCourseUi(locale);
const course = await loadRequiredNeboshCourse(NEBOSH_COURSE_KEYS.eaw, locale);
const commerceProduct = await getOptionalCommerceProduct(NEBOSH_COURSE_KEYS.eaw, locale);
const downloads = [{
	label: 'NEBOSH Award in Environmental Awareness at Work flyer',
	href: '/downloads/nebosh-eaw-english.pdf',
	language: 'English',
}];
---

<BaseLayout title={`${course.title} | HSE Training`} description={course.shortDescription} locale={locale}>
	<main id="main-content">
		<EditorialCoursePage {course} fallback={copy.eaw} {locale} backHref="/nebosh/" backLabel={copy.backToNebosh} contentLabel={copy.contentLabel} contactCta={copy.contactCta} heroImage="/images/nebosh-overview-feature.webp" {downloads} {commerceProduct} />
		<NeboshPartnerBadge {locale} />
	</main>
</BaseLayout>
