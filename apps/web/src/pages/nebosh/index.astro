---
import NeboshOverviewPage from '../../components/nebosh/NeboshOverviewPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NEBOSH_COURSE_KEYS } from '../../lib/course-routes';
import { loadOptionalNeboshCourse } from '../../lib/nebosh-course-content';

const [igcCourse, iogcCourse] = await Promise.all([
	loadOptionalNeboshCourse(NEBOSH_COURSE_KEYS.igc),
	loadOptionalNeboshCourse(NEBOSH_COURSE_KEYS.iogc),
]);
---

<BaseLayout
	title="NEBOSH Qualifications | HSE Training"
	description="Explore NEBOSH health and safety qualifications and course information from HSE Training in Belgrade, Serbia."
>
	<main id="main-content"><NeboshOverviewPage {igcCourse} {iogcCourse} /></main>
</BaseLayout>
