---
import HomeAboutValue from '../components/home/HomeAboutValue.astro';
import HomeClients from '../components/home/HomeClients.astro';
import HomeExperts from '../components/home/HomeExperts.astro';
import HomeFinalCta from '../components/home/HomeFinalCta.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomePricing from '../components/home/HomePricing.astro';
import HomeReference from '../components/home/HomeReference.astro';
import HomeServices from '../components/home/HomeServices.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomepage, getHomepageCourses, getHomepageReferences } from '../lib/cms';

const [homepage, homepageCourses, homepageReferences] = await Promise.all([
	getHomepage(),
	getHomepageCourses(),
	getHomepageReferences(),
]);
---

<BaseLayout
	title="HSE Training | Health and Safety Training"
	description="Professional health, safety and environmental training and consultancy from Belgrade, Serbia."
>
	<main id="main-content">
		<HomeHero content={homepage.hero} />
		<HomeAboutValue content={homepage.about} />
		<HomeServices services={homepage.featuredServices} />
		<HomePricing courses={homepageCourses} />
		<HomeClients />
		<HomeReference references={homepageReferences} />
		<HomeExperts />
		<HomeFinalCta />
	</main>
</BaseLayout>
