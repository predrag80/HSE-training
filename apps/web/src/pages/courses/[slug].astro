---
import CourseDetailPage from '../../components/course/CourseDetailPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCourses, type Course } from '../../lib/cms';
import {
	createLocalizedGenericCourseStaticPaths,
	getCoursePageMetadata,
	type CourseLanguageAlternates,
} from '../../lib/course-pages';

interface Props {
	course: Course;
	languageAlternates: CourseLanguageAlternates;
}

export async function getStaticPaths() {
	const [englishCourses, serbianCourses] = await Promise.all([getCourses('en'), getCourses('sr')]);

	return createLocalizedGenericCourseStaticPaths(englishCourses, serbianCourses);
}

const locale = 'en';
const { course, languageAlternates } = Astro.props;
const metadata = getCoursePageMetadata(course);
---

<BaseLayout title={metadata.title} description={metadata.description} {locale} {languageAlternates}>
	<CourseDetailPage {course} {locale} />
</BaseLayout>
