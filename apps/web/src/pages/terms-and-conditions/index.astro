---
import LegalPage from '../../components/legal/LegalPage.astro';
import { getLegalPage } from '../../lib/cms';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en';
const content = await getLegalPage('terms', locale);
---

<BaseLayout title={content.meta.title} description={content.meta.description} locale={locale}>
	<main id="main-content"><LegalPage {...content} /></main>
</BaseLayout>
