---
import ResourcesPage from '../../components/resources/ResourcesPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResourcesUiTranslations } from '../../i18n/resources-ui';

const locale = 'en';
const copy = getResourcesUiTranslations(locale);
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} locale={locale}>
	<main id="main-content"><ResourcesPage {locale} /></main>
</BaseLayout>
