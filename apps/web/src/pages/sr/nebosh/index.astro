---
import NeboshOverviewPage from '../../../components/nebosh/NeboshOverviewPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getNeboshOverviewPage } from '../../../lib/cms';
import { NEBOSH_COURSE_KEYS } from '../../../lib/course-routes';
import { loadRequiredNeboshCourse } from '../../../lib/nebosh-course-content';

const locale = 'sr';
const [igcCourse, iogcCourse, content] = await Promise.all([
	loadRequiredNeboshCourse(NEBOSH_COURSE_KEYS.igc, locale),
	loadRequiredNeboshCourse(NEBOSH_COURSE_KEYS.iogc, locale),
	getNeboshOverviewPage(locale),
]);
---

<BaseLayout title={content.meta.title} description={content.meta.description} locale={locale}>
	<main id="main-content"><NeboshOverviewPage {igcCourse} {iogcCourse} {locale} {content} /></main>
</BaseLayout>
