---
import ConsultingPage from '../../../components/consulting/ConsultingPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getConsultingUiTranslations } from '../../../i18n/consulting-ui';
import { getServices } from '../../../lib/cms';

const locale = 'sr';
const copy = getConsultingUiTranslations(locale);
const serviceCollection = await getServices(locale);
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} locale={locale}>
	<main id="main-content">
		<ConsultingPage services={serviceCollection.services} {locale} />
	</main>
</BaseLayout>
