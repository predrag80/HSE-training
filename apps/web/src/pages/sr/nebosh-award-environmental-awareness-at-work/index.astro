---
import EditorialCoursePage from '../../../components/course/EditorialCoursePage.astro';
import NeboshPartnerBadge from '../../../components/nebosh/NeboshPartnerBadge.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getEditorialCourseUi } from '../../../i18n/editorial-course-ui';
import { getCourseByKey } from '../../../lib/cms';

const locale = 'sr';
const copy = getEditorialCourseUi(locale);
const course = await getCourseByKey(copy.eaw.courseKey, locale);
const downloads = [{
	label: 'NEBOSH Environmental Awareness at Work – brošura',
	href: '/downloads/nebosh-eaw-english.pdf',
	language: 'Engleski',
}];
---

<BaseLayout title={`${course?.title ?? copy.eaw.title} | HSE Training`} description={course?.shortDescription ?? copy.eaw.metaDescription} locale={locale}>
	<main id="main-content">
		<EditorialCoursePage {course} fallback={copy.eaw} {locale} backHref="/nebosh/" backLabel={copy.backToNebosh} contentLabel={copy.contentLabel} contactCta={copy.contactCta} heroImage="/images/nebosh-overview-feature.webp" {downloads} />
		<NeboshPartnerBadge {locale} />
	</main>
</BaseLayout>
