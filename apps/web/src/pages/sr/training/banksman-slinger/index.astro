---
import OtherCourseDetailPage from '../../../../components/other-courses/OtherCourseDetailPage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getOtherCoursesUiTranslations } from '../../../../i18n/other-courses-ui';
import { getTrainingCourseByKey } from '../../../../lib/cms';
import { TRAINING_COURSE_KEYS } from '../../../../lib/course-routes';

const locale = 'sr';
const copy = getOtherCoursesUiTranslations(locale).banksman;
const course = await getTrainingCourseByKey(TRAINING_COURSE_KEYS.banksman, locale);
const facts = copy.facts.map((fact, index) => index === 1 ? { ...fact, value: course.visiblePrice ?? fact.value } : fact);
const downloads = [
	{
		label: 'Prezentacija za signaliste',
		href: '/downloads/banksman-slinger-prezentacija-srpski.pdf',
		language: 'Srpski',
	},
	{
		label: 'Pismo preporuke za HSE Training',
		href: '/downloads/hse-training-pismo-preporuke.pdf',
		language: 'Engleski',
	},
];
---

<BaseLayout title={`${course.title} | HSE Training`} description={course.shortDescription} locale={locale}>
	<main id="main-content"><OtherCourseDetailPage title={course.title} eyebrow={course.pageEyebrow ?? copy.eyebrow} heroImage={course.featuredImageUrl ?? '/images/consulting-service-04.webp'} featureImage="/images/banksman-slinger-practical.webp" introKicker={copy.introKicker} introTitle={copy.introTitle} intro={copy.intro} introHtml={course.descriptionHtml} {facts} outcomesTitle={copy.outcomesTitle} outcomesIntro={copy.outcomesIntro} outcomes={copy.outcomes} audienceTitle={copy.audienceTitle} audience={copy.audience} {locale} {downloads} /></main>
</BaseLayout>
