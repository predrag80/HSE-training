---
import OtherCoursesOverviewPage from '../../../components/other-courses/OtherCoursesOverviewPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTrainingCourses, getTrainingOverviewPage } from '../../../lib/cms';

const locale = 'sr';
const [courses, content] = await Promise.all([getTrainingCourses(locale), getTrainingOverviewPage(locale)]);
---

<BaseLayout title={content.meta.title} description={content.meta.description} locale={locale}>
	<main id="main-content"><OtherCoursesOverviewPage {locale} {courses} {content} /></main>
</BaseLayout>
