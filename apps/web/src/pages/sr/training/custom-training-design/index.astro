---
import EditorialCoursePage from '../../../../components/course/EditorialCoursePage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getEditorialCourseUi } from '../../../../i18n/editorial-course-ui';
import { getCourseByKey } from '../../../../lib/cms';

const locale = 'sr';
const copy = getEditorialCourseUi(locale);
const course = await getCourseByKey(copy.custom.courseKey, locale);
---

<BaseLayout title={`${course?.title ?? copy.custom.title} | HSE Training`} description={course?.shortDescription ?? copy.custom.metaDescription} locale={locale}>
	<main id="main-content"><EditorialCoursePage {course} fallback={copy.custom} {locale} backHref="/training/" backLabel={copy.backToTraining} contentLabel={copy.contentLabel} contactCta={copy.contactCta} heroImage="/images/consulting-service-01.webp" videoSection={copy.custom.video} /></main>
</BaseLayout>
