---
import OtherCourseDetailPage from '../../../../components/other-courses/OtherCourseDetailPage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getOtherCoursesUiTranslations } from '../../../../i18n/other-courses-ui';
import { getTrainingCourseByKey } from '../../../../lib/cms';
import { TRAINING_COURSE_KEYS } from '../../../../lib/course-routes';

const locale = 'sr';
const copy = getOtherCoursesUiTranslations(locale).trainer;
const course = await getTrainingCourseByKey(TRAINING_COURSE_KEYS.trainer, locale);
const facts = copy.facts.map((fact, index) => index === 1 ? { ...fact, value: course.visiblePrice ?? fact.value } : fact);
---

<BaseLayout title={`${course.title} | HSE Training`} description={course.shortDescription} locale={locale}>
	<main id="main-content"><OtherCourseDetailPage title={course.title} eyebrow={course.pageEyebrow ?? copy.eyebrow} heroImage={course.featuredImageUrl ?? '/images/consulting-hero-02.webp'} featureImage="/images/train-the-trainer-practical.webp" introKicker={copy.introKicker} introTitle={copy.introTitle} intro={copy.intro} introHtml={course.descriptionHtml} {facts} outcomesTitle={copy.outcomesTitle} outcomesIntro={copy.outcomesIntro} outcomes={copy.outcomes} audienceTitle={copy.audienceTitle} audience={copy.audience} {locale} /></main>
</BaseLayout>
