---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import CookieConsent from '../components/site/CookieConsent.astro';
import ScrollProgress from '../components/site/ScrollProgress.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { localeMetadata, type Locale } from '../i18n/config';
import {
	getLanguageAlternates,
	getLocaleFromPathname,
	hasLocalizedContentPath,
} from '../i18n/routes';
import { getUiTranslations } from '../i18n/ui';

interface Props {
	title: string;
	description?: string;
	locale?: Locale;
	robots?: string;
	languageAlternates?: Readonly<Record<Locale, string>>;
}

const {
	title,
	description,
	locale = getLocaleFromPathname(Astro.url.pathname),
	robots,
	languageAlternates,
} = Astro.props;
const ui = getUiTranslations(locale);
const alternates = languageAlternates ?? getLanguageAlternates(Astro.url.pathname);
const hasSerbianAlternate = hasLocalizedContentPath(Astro.url.pathname);
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL('/images/HSE_Training_logo_transparent.png', siteUrl).href;
const socialLocale = locale === 'sr' ? 'sr_RS' : 'en_US';
const alternateUrls = {
	en: new URL(alternates.en, siteUrl).href,
	sr: new URL(alternates.sr, siteUrl).href,
};
---

<!doctype html>
<html lang={localeMetadata[locale].htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{robots && <meta name="robots" content={robots} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="HSE Training" />
		<meta property="og:locale" content={socialLocale} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:secure_url" content={socialImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="900" />
		<meta property="og:image:height" content="335" />
		<meta property="og:image:alt" content="HSE Training DOO logo" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="HSE Training DOO logo" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={alternateUrls.en} />
		{hasSerbianAlternate && <link rel="alternate" hreflang="sr" href={alternateUrls.sr} />}
		<link rel="alternate" hreflang="x-default" href={alternateUrls.en} />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">{ui.skipLink}</a>
		<Header locale={locale} languageAlternates={alternates} />
		<slot />
		<SiteFooter locale={locale} />
		<ScrollProgress locale={locale} />
		<CookieConsent locale={locale} />
	</body>
</html>
